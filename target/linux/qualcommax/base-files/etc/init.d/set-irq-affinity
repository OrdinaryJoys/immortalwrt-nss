#!/bin/sh /etc/rc.common
# shellcheck disable=2034,3043

START=99

get_cpu_mask() {
	local cpu range start end mask=0

	for range in $(tr ',' ' ' < /sys/devices/system/cpu/online 2> /dev/null); do
		start="${range%-*}"
		end="${range#*-}"
		[ "$start" = "$end" ] && end="$start"

		for cpu in $(seq "$start" "$end"); do
			mask=$((mask | (1 << cpu)))
		done
	done

	[ "$mask" -gt 0 ] || mask=1
	printf '%x' "$mask"
}

get_board_devices() {
	# DSA-style LANs are represented by network.*.ports[], while routed
	# interfaces such as WAN use network.*.device. Cover both layouts so
	# qca-nss-dp host traffic gets the same RPS/RFS policy on every port.
	# First-boot fix (K-15b, 2026-08-13): /etc/board.json does not exist on
	# the very first boot — the image ships no board.json and preinit only
	# writes /tmp/board.json. Fall back: /tmp/board.json -> uci network
	# config -> sysfs scan, so RPS applies on every boot.
	local devices

	devices=$(jsonfilter -i /etc/board.json \
		-e '@.network[*].device' \
		-e '@.network[*].ports[*]' 2>/dev/null | sort -u)
	[ -n "$devices" ] || devices=$(jsonfilter -i /tmp/board.json \
		-e '@.network[*].device' \
		-e '@.network[*].ports[*]' 2>/dev/null | sort -u)
	[ -n "$devices" ] || devices=$(jsonfilter -i /etc/config/network \
		-e '@.device[*].ports[*]' \
		-e '@.interface[*].device' 2>/dev/null | sort -u)
	[ -n "$devices" ] || devices=$(ls /sys/class/net 2>/dev/null | grep -E '^(lan|wan)' | sort -u)
	printf '%s\n' "$devices"
}

start() {
	local flow_cnt sock_flow_entries cpu_mask devices

	flow_cnt=8192
	sock_flow_entries=65535
	cpu_mask="$(get_cpu_mask)"
	devices="$(get_board_devices)"
	logger -t set-irq-affinity "RPS start: devices=$(echo "$devices" | tr '\n' ' ')"

	for eth in $devices; do
		[ -d "/sys/class/net/$eth" ] || continue
		for i in "/sys/class/net/$eth"/queues/rx-*/rps_cpus; do [ -w "$i" ] && echo "$cpu_mask" > "$i"; done
		for i in "/sys/class/net/$eth"/queues/rx-*/rps_flow_cnt; do [ -w "$i" ] && echo "$flow_cnt" > "$i"; done
		for i in "/sys/class/net/$eth"/queues/tx-*/xps_cpus; do [ -w "$i" ] && echo "$cpu_mask" > "$i"; done
	done

	[ -w "/proc/sys/net/core/rps_sock_flow_entries" ] && echo "$sock_flow_entries" > "/proc/sys/net/core/rps_sock_flow_entries"
}
