--- a/drivers/remoteproc/qcom_q6v5_wcss.c
+++ b/drivers/remoteproc/qcom_q6v5_wcss.c
@@ -261,11 +261,20 @@ static int q6v5_wcss_start(struct rproc *rproc)
 		return ret;
 	}
 
-	if (wcss->qdss_clk)
