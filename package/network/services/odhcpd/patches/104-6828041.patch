From 6828041a914fcc9ef14b536c09898354d854c253 Mon Sep 17 00:00:00 2001
From: Duc Anh Luu <luuducanh05051995@gmail.com>
Date: Sat, 24 Oct 2026 16:28:20 +0700
Subject: [PATCH] dhcpv6-ia: accept only the sub-option of the IA type

build_ia() and dhcpv6_ia_on_link() accept IA_PREFIX and IA_ADDR
sub-options in either IA type, but pick the structure layout from the
parent IA type. An IA_ADDR (28 bytes) inside an IA_PD is read as a
29-byte dhcpv6_ia_prefix, so the 16-byte memcmp() of ia_p->addr reads
one byte past the option and, if it is the last option, past the
datagram. A 62-byte multicast Rebind is enough; with the IA_PD ending
exactly at the 8192-byte receive buffer the read leaves data_buf in
odhcpd_receive_packets(). The comparison result decides whether the
address is echoed back with zero lifetimes, so the client can observe
whether the out-of-bounds byte is zero.

Only accept the sub-option type that belongs to the IA (IA_PREFIX in
IA_PD, IA_ADDR in IA_NA), as RFC 8415 sections 21.4 and 21.21 require.

Found with libFuzzer + AddressSanitizer, reproduced against the daemon.

Signed-off-by: Duc Anh Luu <luuducanh05051995@gmail.com>
[split from a combined fix, reworded the subject]
Link: https://github.com/openwrt/odhcpd/pull/428
Signed-off-by: John Crispin <john@phrozen.org>
---
 src/dhcpv6-ia.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/dhcpv6-ia.c b/src/dhcpv6-ia.c
index 7096d47..e568fee 100644
--- a/src/dhcpv6-ia.c
+++ b/src/dhcpv6-ia.c
@@ -753,8 +753,9 @@ static size_t build_ia(uint8_t *buf, size_t buflen, uint16_t status,
 			struct dhcpv6_ia_addr *ia_a = (struct dhcpv6_ia_addr *)&odata[-DHCPV6_OPT_HDR_SIZE];
 			bool found = false;
 
-			if ((otype != DHCPV6_OPT_IA_PREFIX || olen < sizeof(*ia_p) - DHCPV6_OPT_HDR_SIZE) &&
-					(otype != DHCPV6_OPT_IA_ADDR || olen < sizeof(*ia_a) - DHCPV6_OPT_HDR_SIZE))
+			if (ia->type == htons(DHCPV6_OPT_IA_PD) ?
+			    (otype != DHCPV6_OPT_IA_PREFIX || olen < sizeof(*ia_p) - DHCPV6_OPT_HDR_SIZE) :
+			    (otype != DHCPV6_OPT_IA_ADDR || olen < sizeof(*ia_a) - DHCPV6_OPT_HDR_SIZE))
 				continue;
 
 			if (a) {
@@ -934,8 +935,9 @@ static bool dhcpv6_ia_on_link(const struct dhcpv6_ia_hdr *ia, struct dhcpv6_leas
 		struct dhcpv6_ia_prefix *p = (struct dhcpv6_ia_prefix *)&odata[-DHCPV6_OPT_HDR_SIZE];
 		struct dhcpv6_ia_addr *n = (struct dhcpv6_ia_addr *)&odata[-DHCPV6_OPT_HDR_SIZE];
 
-		if ((otype != DHCPV6_OPT_IA_PREFIX || olen < sizeof(*p) - DHCPV6_OPT_HDR_SIZE) &&
-				(otype != DHCPV6_OPT_IA_ADDR || olen < sizeof(*n) - DHCPV6_OPT_HDR_SIZE))
+		if (ia->type == htons(DHCPV6_OPT_IA_PD) ?
+		    (otype != DHCPV6_OPT_IA_PREFIX || olen < sizeof(*p) - DHCPV6_OPT_HDR_SIZE) :
+		    (otype != DHCPV6_OPT_IA_ADDR || olen < sizeof(*n) - DHCPV6_OPT_HDR_SIZE))
 			continue;
 
 		onlink = false;
