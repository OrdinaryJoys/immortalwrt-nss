[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

ubootenv_mtdinfo () {
	UBOOTENV_PART=$(cat /proc/mtd | grep -i APPSBLENV)
	mtd_dev=$(echo $UBOOTENV_PART | awk '{print $1}' | sed 's/:$//')
	mtd_size=$(echo $UBOOTENV_PART | awk '{print "0x"$2}')
	mtd_erase=$(echo $UBOOTENV_PART | awk '{print "0x"$3}')
	nor_flash=$(find /sys/bus/spi/devices/*/mtd -name ${mtd_dev})

	if [ -n "$nor_flash" ]; then
		ubootenv_size=$mtd_size
	else
		# size is fixed to 0x40000 in u-boot
		ubootenv_size=0x40000
	fi

	sectors=$(( $ubootenv_size / $mtd_erase ))
	sectors=$(printf "0x%x" $sectors )
	echo /dev/$mtd_dev 0x0 $ubootenv_size $mtd_erase $sectors
}

case "$board" in
aliyun,ap8220|\
compex,wpq873|\
edgecore,eap102|\
zyxel,nbg7815|\
zyxel,nwa110ax|\
zyxel,nwa210ax)
	ubootenv_add_mtd "0:appsblenv" "0x0" "0x10000" "0x10000"
	;;
asus,rt-ax89x|\
qnap,301w)
	ubootenv_add_mtd "0:appsblenv" "0x0" "0x20000" "0x20000"
	;;
dynalink,dl-wrx36|\
netgear,rax120v2|\
netgear,rbr750|\
netgear,rbs750|\
netgear,sxr80|\
netgear,sxs80|\
netgear,wax218|\
netgear,wax620|\
netgear,wax630|\
tplink,deco-x80-5g|\
tplink,eap620-hd-v1|\
tplink,eap660-hd-v1)
	ubootenv_add_mtd "0:appsblenv" "0x0" "0x40000" "0x20000"
	;;
edimax,cax1800|\
zte,mf269)
	ubootenv_add_mtd "0:appsblenv" "0x0" "0x10000" "0x20000"
	;;
linksys,homewrk)
	ubootenv_add_mtd "0:appsblenv" "0x0" "0x40000" "0x40000"
	;;
linksys,mx4200v1|\
linksys,mx4200v2|\
linksys,mx5300|\
linksys,mx8500)
	ubootenv_add_mtd "u_env" "0x0" "0x40000" "0x20000"
	;;
linksys,mx4300)
	ubootenv_add_mtd "u_env" "0x0" "0x40000" "0x40000"
	;;
prpl,haze)
	ubootenv_add_mmc "0:APPSBLENV" "" "0x0" "0x40000" "0x400" "0x100"
	;;
redmi,ax6|\
redmi,ax6-stock)
	# S1-01: the stock Xiaomi env geometry is 64 KiB, but the installed
	# merged-layout U-Boot may use a 256 KiB (0x40000) environment.  Never
	# select the larger geometry statically: accept it only when a runtime
	# read proves a CRC-valid 256 KiB U-Boot environment on this boot.
	# Otherwise keep the stock 0x10000 geometry and report S1-01 OPEN.
	# This arm never calls fw_setenv and never writes MTD.
	ax6_envsize=0x10000
	if [ -z "$(find_mtd_index rootfs_1)" ]; then
		ax6_env_mtd=$(find_mtd_index "0:appsblenv")
		ax6_env_probe=
		ax6_env_tmp=$(mktemp /tmp/fw_env.ax6.XXXXXX 2>/dev/null)
		if [ -n "$ax6_env_mtd" ] && [ -n "$ax6_env_tmp" ] &&
		   printf '/dev/mtd%s 0x0 0x40000 0x20000\n' "$ax6_env_mtd" >"$ax6_env_tmp"; then
			fw_printenv -c "$ax6_env_tmp" -n bootcmd \
				>"$ax6_env_tmp.out" 2>"$ax6_env_tmp.err"
			[ "$?" -eq 0 ] && ax6_env_probe=1
			# fw_printenv falls back to its compiled-in default
			# environment (bootcmd="run distro_bootcmd") after a bad CRC
			# and still exits 0, so a value alone is not proof: reject the
			# bad-CRC warning and require the merged-layout boot command.
			grep -q "Bad CRC" "$ax6_env_tmp.err" 2>/dev/null && ax6_env_probe=
			[ -n "$ax6_env_probe" ] &&
				grep -q "bootipq" "$ax6_env_tmp.out" 2>/dev/null || ax6_env_probe=
		fi
		[ -n "$ax6_env_tmp" ] &&
			rm -f "$ax6_env_tmp" "$ax6_env_tmp.out" "$ax6_env_tmp.err"
		if [ -n "$ax6_env_probe" ]; then
			ax6_envsize=0x40000
			echo "ax6-uboot-env-geometry: probe-verified 0x40000 U-Boot environment"
		else
			echo "ax6-uboot-env-geometry: OPEN S1-01 - 256 KiB U-Boot env unproven; keeping 0x10000"
		fi
	fi
	ubootenv_add_mtd "0:appsblenv" "0x0" "$ax6_envsize" "0x20000"
	ubootenv_add_sys_mtd "bdata" "0x0" "0x10000" "0x20000"
	;;
xiaomi,ax3600|\
xiaomi,ax3600-stock|\
xiaomi,ax9000|\
xiaomi,ax9000-stock)
	ubootenv_add_mtd "0:appsblenv" "0x0" "0x10000" "0x20000"
	ubootenv_add_sys_mtd "bdata" "0x0" "0x10000" "0x20000"
	;;
spectrum,sax1v1k|\
verizon,cr1000a)
	ubootenv_add_mmc "0:APPSBLENV" "" "0x0" "0x40000" "0x40000"
	;;
tcl,linkhub-hh500v)
	ubootenv_add_uci_config $(ubootenv_mtdinfo)
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
