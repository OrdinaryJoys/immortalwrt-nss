+static bool checked_journal_uint(const char *text, unsigned long long maximum,
+				 unsigned long long *value)
+{
+	unsigned long long number;
+	char *end;
+
+	if (!text || *text < '0' || *text > '9')
+		return false;
+	errno = 0;
+	number = strtoull(text, &end, 10);
+	if (errno || *end || number > maximum)
+		return false;
+	if (value)
+		*value = number;
+	return true;
+}
