+static void checked_storage_init(void)
+{
+	if (mkdir(RPC_CHECKED_DIR, 0700) && errno != EEXIST) {
+		syslog(LOG_ERR, "uci.checked: mkdir %s: %m", RPC_CHECKED_DIR);
+		checked_journal_blocked = true;
+		return;
+	}
+	if (mkdir(RPC_SNAPSHOT_FILES, 0700) && errno != EEXIST) {
+		syslog(LOG_ERR, "uci.checked: mkdir %s: %m", RPC_SNAPSHOT_FILES);
+		checked_journal_blocked = true;
+		return;
+	}
+	if (mkdir(RPC_SNAPSHOT_DELTA, 0700) && errno != EEXIST) {
+		syslog(LOG_ERR, "uci.checked: mkdir %s: %m", RPC_SNAPSHOT_DELTA);
+		checked_journal_blocked = true;
+	}
+}
