+static bool
+checked_token_matches(const struct checked_transaction *txn, const char *token)
+{
+	unsigned int i, difference = 0;
+	if (txn->state == CHECKED_NONE)
+		return false;
+	for (i = 0; i < 32; i++) {
+		difference |= (unsigned char)txn->id[i] ^ (unsigned char)token[i];
+		difference |= (unsigned char)txn->request[i] ^ (unsigned char)token[i + 32];
+	}
+	return difference == 0;
+}
