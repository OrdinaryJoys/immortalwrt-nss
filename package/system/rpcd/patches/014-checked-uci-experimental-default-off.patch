+		return UBUS_STATUS_UNKNOWN_ERROR;
+	if (txn == &checked_current && apply_timer.pending)
+		remaining = uloop_timeout_remaining64(&apply_timer);
+	ret = blobmsg_add_u32(&reply, "protocol", 1);
+	ret |= blobmsg_add_string(&reply, "state", txn ? names[txn->state] : fallback);
+	ret |= blobmsg_add_u32(&reply, "remaining_ms", remaining > 0 ? remaining : 0);
+	ret |= blobmsg_add_u8(&reply, "cleanup_pending", txn && txn->cleanup_pending);
+	if (txn) {
+		snprintf(token, sizeof(token), "%s%s", txn->id, txn->request);
+		ret |= blobmsg_add_string(&reply, "token", token);
+	}
+	if (!ret)
+		ret = ubus_send_reply(ctx, req, reply.head);
+	blob_buf_free(&reply);
+	return ret ? UBUS_STATUS_UNKNOWN_ERROR : 0;
+}
+
+static int
+rpc_uci_checked(struct ubus_context *ctx, struct ubus_object *obj,
+                struct ubus_request_data *req, const char *method,
+                struct blob_attr *msg)
+{
+	struct blob_attr *tb[__CHECK_MAX];
+	struct checked_transaction *txn;
+	struct blob_buf args = {};
+	const char *command, *sid = NULL, *request = NULL, *token = NULL;
+	unsigned int timeout;
+	int ret;
+
+	if (!RPCD_CHECKED_UCI_SUPPORT)
+		return UBUS_STATUS_NOT_SUPPORTED;
+
+	blobmsg_parse(checked_policy, __CHECK_MAX, tb, blob_data(msg), blob_len(msg));
+	if (!tb[CHECK_COMMAND])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	command = blobmsg_get_string(tb[CHECK_COMMAND]);
+	if (!strcmp(command, "capabilities"))
+		return checked_reply(ctx, req, NULL, "idle");
+	if (strcmp(command, "status") && strcmp(command, "apply") &&
+	    strcmp(command, "confirm") && strcmp(command, "rollback"))
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	if (tb[CHECK_SESSION])
+		sid = blobmsg_get_string(tb[CHECK_SESSION]);
+	if (tb[CHECK_REQUEST]) {
+		request = blobmsg_get_string(tb[CHECK_REQUEST]);
+		if (!checked_hex(request, 32))
+			return UBUS_STATUS_INVALID_ARGUMENT;
+	}
+	if (tb[CHECK_TOKEN]) {
+		token = blobmsg_get_string(tb[CHECK_TOKEN]);
+		if (!checked_hex(token, 64))
+			return UBUS_STATUS_INVALID_ARGUMENT;
+	}
+	if (!strcmp(command, "apply") || (!strcmp(command, "status") && !token)) {
+		if (!sid || !checked_hex(sid, RPC_SID_LEN) ||
+		    !strcmp(sid, "00000000000000000000000000000000") ||
+		    !rpc_session_exists(sid))
+			return UBUS_STATUS_PERMISSION_DENIED;
+		txn = request ? checked_find_request(sid, request) : NULL;
+		if (!strcmp(command, "status")) {
+			if (!request && checked_active() && !strcmp(checked_current.sid, sid))
+				txn = &checked_current;
+			return checked_reply(ctx, req, txn, request ? "unknown" :
+				(apply_sid[0] && !checked_active() && !strcmp(apply_sid, sid) ? "legacy" : "idle"));
+		}
+		if (!request || !tb[CHECK_TIMEOUT] || token)
+			return UBUS_STATUS_INVALID_ARGUMENT;
+		timeout = blobmsg_get_u32(tb[CHECK_TIMEOUT]);
+		if (!timeout || timeout > INT_MAX / 1000)
+			return UBUS_STATUS_INVALID_ARGUMENT;
+		if (txn)
+			return checked_reply(ctx, req, txn, "unknown");
+		if (blob_buf_init(&args, 0))
+			return UBUS_STATUS_UNKNOWN_ERROR;
+		ret = blobmsg_add_string(&args, "ubus_rpc_session", sid);
+		ret |= blobmsg_add_u8(&args, "rollback", true);
+		ret |= blobmsg_add_u32(&args, "timeout", timeout);
+		if (!ret)
+			ret = rpc_uci_apply_common(ctx, obj, req, method, args.head, request);
+		else
+			ret = UBUS_STATUS_UNKNOWN_ERROR;
+		blob_buf_free(&args);
+		if (ret)
+			return ret;
+		return checked_reply(ctx, req, &checked_current, "unknown");
+	}
+	if (!token)
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	txn = checked_find_token(token);
+	if (!txn || !strcmp(command, "status") || txn != &checked_current)
+		return checked_reply(ctx, req, txn, "unknown");
+
+	/* An expired deadline cannot be extended by a queued confirm request. */
+	if (apply_timer.pending && uloop_timeout_remaining64(&apply_timer) <= 0) {
+		rpc_uci_apply_timeout(&apply_timer);
+		txn = checked_find_token(token);
+		if (!txn || txn != &checked_current)
+			return checked_reply(ctx, req, txn, "unknown");
+	}
+	if (!strcmp(command, "confirm") &&
+	    (txn->state != CHECKED_PENDING || !rpc_session_exists(txn->sid)))
+		return checked_reply(ctx, req, txn, "unknown");
+	if (blob_buf_init(&args, 0))
+		return UBUS_STATUS_UNKNOWN_ERROR;
+	ret = blobmsg_add_string(&args, "ubus_rpc_session", txn->sid);
+	if (!ret) {
+		if (!strcmp(command, "confirm"))
+			ret = rpc_uci_confirm_common(ctx, obj, req, method, args.head, true);
+		else
+			ret = rpc_uci_rollback_common(ctx, obj, req, method, args.head, true);
+	}
+	else
+		ret = UBUS_STATUS_UNKNOWN_ERROR;
+	blob_buf_free(&args);
+	if (ret)
+		return ret;
+	return checked_reply(ctx, req, checked_find_token(token), "unknown");
+}
