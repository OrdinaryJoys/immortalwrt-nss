+static bool checked_hex(const char *value, size_t length)
+{
+	size_t i;
+	if (!value || strlen(value) != length)
+		return false;
+	for (i = 0; i < length; i++)
+		if (!((value[i] >= '0' && value[i] <= '9') ||
+		      (value[i] >= 'a' && value[i] <= 'f')))
+			return false;
+	return true;
+}
+
+static int checked_random(char id[33])
+{
+	unsigned char bytes[16];
+	size_t offset = 0, i;
+	ssize_t n;
+	static const char hex[] = "0123456789abcdef";
+	while (offset < sizeof(bytes)) {
+		n = getrandom(bytes + offset, sizeof(bytes) - offset, 0);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0)
+			return UBUS_STATUS_UNKNOWN_ERROR;
+		offset += n;
+	}
+	for (i = 0; i < sizeof(bytes); i++) {
+		id[2 * i] = hex[bytes[i] >> 4];
+		id[2 * i + 1] = hex[bytes[i] & 15];
+	}
+	id[32] = 0;
+	return 0;
+}
