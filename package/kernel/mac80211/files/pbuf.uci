config general opt
  option auto_scale 'off'
  # option memory_profile 'off'
  option memory_profile 'auto'
  # option memory_profile '1gb'
  # option memory_profile '512mb'
  # option memory_profile '256mb'
  option scaling_governor 'performance'
  option reload_wifi '0'
  # n2h_queue_limit: 2048 for >=1GB, 256 only for <=512MB (qosmio recommendation)
  option n2h_queue_limit_core0 '2048'
  option n2h_queue_limit_core1 '2048'
  # qosmio 1GB profile defaults (override via UCI)
  # option n2h_high_water_core0 '72512'
  # option n2h_wifi_pool_buf '36864'
  # option extra_pbuf_core0 '10000000'
