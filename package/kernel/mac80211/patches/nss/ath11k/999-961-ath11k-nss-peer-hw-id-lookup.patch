+static struct ath11k_peer *ath11k_nss_find_peer_by_hw_id(struct ath11k_base *ab,
+						       u32 hw_peer_id)
+{
+	struct ath11k_peer *peer;
+
+	list_for_each_entry(peer, &ab->peers, list) {
+		if (peer->hw_peer_id == hw_peer_id)
+			return peer;
+	}
+
+	return NULL;
+}
