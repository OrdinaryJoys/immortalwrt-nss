From: AX6 local correctness review <local@localhost>
Subject: [PATCH] ath11k: nss: parse available wifili peer stats records

Firmware may report npeers larger than the records actually present in
cm.len. Parse only complete records that fit, preserve OOB bounds, and
log both the reported and parsed peer counts.

Upstream-Status: Pending

--- a/drivers/net/wireless/ath/ath11k/nss.c
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -155,10 +155,10 @@
  */
 static bool ath11k_nss_peer_stats_len_ok(struct ath11k_base *ab,
 					 const struct nss_wifili_peer_stats *stats,
-					 u32 len)
+					 u32 len, u32 *parse_npeers)
 {
 	size_t stride = sizeof(stats->wpcs[0]);
-	size_t required;
+	size_t available;
 	u32 npeers;
 
 	if (len < sizeof(stats->npeers)) {
@@ -180,21 +180,49 @@
 		return false;
 	}
 
-	required = sizeof(*stats) + (npeers - 1) * stride;
-	if (len < required) {
+	/* A payload shorter than one complete compiled-layout record cannot be
+	 * parsed. A payload whose length is an exact multiple of the legacy
+	 * 196-byte stride but not of the compiled stride is the foreign layout and
+	 * must be rejected before any peer is read. Otherwise allow a trailing
+	 * partial record, but only parse complete records that fit.
+	 */
+	if (len < sizeof(*stats)) {
 		if (!ab->nss.peer_stats_len_warned) {
 			ab->nss.peer_stats_len_warned = true;
 			ath11k_warn(ab, "nss wifili peer stats: payload too short: "
-				    "len=%u required=%zu npeers=%u stride=%zu\n",
-				    len, required, npeers, stride);
+				    "len=%u npeers=%u stride=%zu\n",
+				    len, npeers, stride);
 		}
 		return false;
 	}
 
+	if (((len - sizeof(stats->npeers)) % 196) == 0 &&
+	    ((len - sizeof(stats->npeers)) % stride) != 0) {
+		if (!ab->nss.peer_stats_len_warned) {
+			ab->nss.peer_stats_len_warned = true;
+			ath11k_warn(ab, "nss wifili peer stats: payload too short: "
+				    "len=%u npeers=%u stride=%zu\n",
+				    len, npeers, stride);
+		}
+		return false;
+	}
+
+	available = (len - sizeof(stats->npeers)) / stride;
+
+	*parse_npeers = npeers;
+	if (*parse_npeers > available)
+		*parse_npeers = available;
+	if (*parse_npeers < npeers && !ab->nss.peer_stats_len_warned) {
+		ab->nss.peer_stats_len_warned = true;
+		ath11k_warn(ab, "nss wifili peer stats: truncated: len=%u npeers=%u "
+			    "parse_npeers=%u stride=%zu\n",
+			    len, npeers, *parse_npeers, stride);
+	}
+
 	if (!ab->nss.peer_stats_layout_logged) {
 		ab->nss.peer_stats_layout_logged = true;
-		ath11k_info(ab, "nss wifili peer stats: len=%u npeers=%u stride=%zu\n",
-			    len, npeers, stride);
+		ath11k_info(ab, "nss wifili peer stats: len=%u npeers=%u parse_npeers=%u stride=%zu\n",
+			    len, npeers, *parse_npeers, stride);
 	}
 
 	return true;
@@ -206,6 +234,7 @@
 	struct nss_wifili_peer_stats *stats = &msg->msg.peer_stats.stats;
 	struct ath11k_peer *peer;
 	struct nss_wifili_peer_ctrl_stats *pstats = NULL;
+	u32 parse_npeers;
 	int i, j;
 	u64 tx_packets, tx_bytes, tx_dropped;
 	u64 rx_packets, rx_bytes, rx_dropped;
@@ -213,10 +242,10 @@
 	if (!ab->nss.stats_enabled)
 		return;
 
-	if (!ath11k_nss_peer_stats_len_ok(ab, stats, msg->cm.len))
+	if (!ath11k_nss_peer_stats_len_ok(ab, stats, msg->cm.len, &parse_npeers))
 		return;
 
-	for (i = 0; i < stats->npeers; i++) {
+	for (i = 0; i < parse_npeers; i++) {
 		pstats = &stats->wpcs[i];
 
 		rcu_read_lock();
