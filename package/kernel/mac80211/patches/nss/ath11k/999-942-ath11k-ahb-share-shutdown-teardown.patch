Subject: ath11k: 999-942-ath11k-ahb-share-shutdown-teardown.patch

--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -1422,24 +1422,11 @@
 
 static void ath11k_ahb_shutdown(struct platform_device *pdev)
 {
-	struct ath11k_base *ab = platform_get_drvdata(pdev);
-
 	/* platform shutdown() & remove() are mutually exclusive.
-	 * remove() is invoked during rmmod & shutdown() during
-	 * system reboot/shutdown.
+	 * Share the complete registered/unregistered teardown rather than
+	 * freeing an unregistered base with its QMI handle still alive.
 	 */
-	ath11k_ahb_remove_prepare(ab);
-
-	if (!(test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags))) {
-		ath11k_core_pm_notifier_unregister(ab);
-		goto free_resources;
-	}
-
-	ath11k_core_deinit(ab);
-
-free_resources:
-	ath11k_fw_destroy(ab);
-	ath11k_ahb_free_resources(ab);
+	ath11k_ahb_remove(pdev);
 }
 
 #if LINUX_VERSION_IS_LESS(6,11,0)
