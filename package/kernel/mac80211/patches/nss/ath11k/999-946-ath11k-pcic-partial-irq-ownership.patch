Subject: [PATCH] ath11k: pair partial PCIC IRQ ownership with bus error unwind

Track only successfully registered actions and NAPI devices, retain partial
ownership until the bus caller unwinds, and clear ownership after release.
PCI uses its existing affinity-hint cleanup label; hybrid AHB has no PCI hint
and releases partial ownership before returning. Keep NSS filtering, MSI
mapping, flags and successful disable sequence unchanged. Reject empty MSI
assignments before modulo arithmetic.

The upstream 637c435f netdev fix is already present but does not release IRQ
actions or unregister NAPI on all exits. Preserve the affinity ordering from
upstream 68410c5b. This local adaptation is not an upstream-reviewed change.
Host resource fixtures do not qualify actual PCI/hybrid hardware.

--- a/drivers/net/wireless/ath/ath11k/pcic.c
+++ b/drivers/net/wireless/ath/ath11k/pcic.c
@@ -334,11 +334,16 @@
 	for (i = 0; i < ATH11K_EXT_IRQ_GRP_NUM_MAX; i++) {
 		struct ath11k_ext_irq_grp *irq_grp = &ab->ext_irq_grp[i];
 
+		if (!irq_grp->napi_ndev)
+			continue;
+
 		for (j = 0; j < irq_grp->num_irq; j++)
 			free_irq(ab->irq_num[irq_grp->irqs[j]], irq_grp);
 
 		netif_napi_del(&irq_grp->napi);
 		free_netdev(irq_grp->napi_ndev);
+		irq_grp->napi_ndev = NULL;
+		irq_grp->num_irq = 0;
 	}
 }
 
@@ -350,7 +355,10 @@
 		if (ath11k_ce_get_attr_flags(ab, i) & CE_ATTR_DIS_INTR)
 			continue;
 		irq_idx = ATH11K_PCI_IRQ_CE0_OFFSET + i;
-		free_irq(ab->irq_num[irq_idx], &ab->ce.ce_pipe[i]);
+		if (ab->irq_num[irq_idx] >= 0) {
+			free_irq(ab->irq_num[irq_idx], &ab->ce.ce_pipe[i]);
+			ab->irq_num[irq_idx] = -1;
+		}
 	}
 
 	ath11k_pcic_free_ext_irq(ab);
@@ -583,7 +591,7 @@
 
 static int ath11k_pcic_ext_irq_config(struct ath11k_base *ab)
 {
-	int i, j, n, ret, num_vectors = 0;
+	int i, j, ret, num_vectors = 0;
 	u32 user_base_data = 0, base_vector = 0;
 	struct ath11k_ext_irq_grp *irq_grp;
 	unsigned long irq_flags;
@@ -594,6 +602,8 @@
 						  &base_vector);
 	if (ret < 0)
 		return ret;
+	if (num_vectors <= 0)
+		return -EINVAL;
 
 	irq_flags = IRQF_SHARED;
 	if (!test_bit(ATH11K_FLAG_MULTI_MSI_VECTORS, &ab->dev_flags))
@@ -606,10 +616,8 @@
 		irq_grp->ab = ab;
 		irq_grp->grp_id = i;
 		irq_grp->napi_ndev = alloc_netdev_dummy(0);
-		if (!irq_grp->napi_ndev) {
-			ret = -ENOMEM;
-			goto fail_allocate;
-		}
+		if (!irq_grp->napi_ndev)
+			return -ENOMEM;
 
 		snprintf(irq_grp->napi_ndev->name, sizeof(irq_grp->napi_ndev->name), "%s%d:%d",
 			 "ath11k_pci", devidx, i);
@@ -634,20 +642,16 @@
 			num_irq = 1;
 		}
 
-		irq_grp->num_irq = num_irq;
+		irq_grp->num_irq = 0;
 		irq_grp->irqs[0] = ATH11K_PCI_IRQ_DP_OFFSET + i;
 
-		for (j = 0; j < irq_grp->num_irq; j++) {
+		for (j = 0; j < num_irq; j++) {
 			int irq_idx = irq_grp->irqs[j];
 			int vector = (i % num_vectors) + base_vector;
 			int irq = ath11k_pcic_get_msi_irq(ab, vector);
 
-			if (irq < 0) {
-				ret = irq;
-				goto fail_irq;
-			}
-
-			ab->irq_num[irq_idx] = irq;
+			if (irq < 0)
+				return irq;
 
 			ath11k_dbg(ab, ATH11K_DBG_PCI,
 				   "irq %d group %d\n", irq, i);
@@ -658,12 +662,10 @@
 			if (ret) {
 				ath11k_err(ab, "failed request irq %d: %d\n",
 					   vector, ret);
-				for (n = 0; n <= i; n++) {
-					irq_grp = &ab->ext_irq_grp[n];
-					free_netdev(irq_grp->napi_ndev);
-				}
 				return ret;
 			}
+			ab->irq_num[irq_idx] = irq;
+			irq_grp->num_irq++;
 		}
 		ath11k_pcic_ext_grp_disable(irq_grp);
 	}
@@ -671,15 +673,6 @@
 	devidx++;
 
 	return 0;
-fail_irq:
-	/* i ->napi_ndev was properly allocated. Free it also */
-	i += 1;
-fail_allocate:
-	for (n = 0; n < i; n++) {
-		irq_grp = &ab->ext_irq_grp[n];
-		free_netdev(irq_grp->napi_ndev);
-	}
-	return ret;
 }
 
 int ath11k_pcic_config_irq(struct ath11k_base *ab)
@@ -692,10 +685,16 @@
 	int irq, i, ret, irq_idx;
 	unsigned long irq_flags;
 
+	/* The caller frees partial ownership after clearing any affinity hint. */
+	for (i = 0; i < ab->hw_params.ce_count; i++)
+		ab->irq_num[ATH11K_PCI_IRQ_CE0_OFFSET + i] = -1;
+
 	ret = ath11k_pcic_get_user_msi_assignment(ab, "CE", &msi_data_count,
 						  &msi_data_start, &msi_irq_start);
 	if (ret)
 		return ret;
+	if (!msi_data_count)
+		return -EINVAL;
 
 	irq_flags = IRQF_SHARED;
 	if (!test_bit(ATH11K_FLAG_MULTI_MSI_VECTORS, &ab->dev_flags))
--- a/drivers/net/wireless/ath/ath11k/pcic.h
+++ b/drivers/net/wireless/ath/ath11k/pcic.h
@@ -35,6 +35,7 @@
 				 u32 *msi_addr_hi);
 void ath11k_pcic_get_ce_msi_idx(struct ath11k_base *ab, u32 ce_id, u32 *msi_idx);
 void ath11k_pcic_free_irq(struct ath11k_base *ab);
+/* On failure, clear bus affinity hints, then free partial IRQ ownership. */
 int ath11k_pcic_config_irq(struct ath11k_base *ab);
 void ath11k_pcic_ext_irq_enable(struct ath11k_base *ab);
 void ath11k_pcic_ext_irq_disable(struct ath11k_base *ab);
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -1144,7 +1144,7 @@
 	ret = ath11k_pcic_config_irq(ab);
 	if (ret) {
 		ath11k_err(ab, "failed to config irq: %d\n", ret);
-		goto err_ce_free;
+		goto err_free_irq;
 	}
 
 	/* kernel may allocate a dummy vector before request_irq and
@@ -1171,7 +1171,6 @@
 	ath11k_pci_set_irq_affinity_hint(ab_pci, NULL);
 	ath11k_pcic_free_irq(ab);
 
-err_ce_free:
 	ath11k_ce_free_pipes(ab);
 
 err_hal_srng_deinit:
--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -703,8 +703,12 @@
 	int irq, irq_idx, i;
 	int ret;
 
-	if (ab->hw_params.hybrid_bus_type)
-		return ath11k_pcic_config_irq(ab);
+	if (ab->hw_params.hybrid_bus_type) {
+		ret = ath11k_pcic_config_irq(ab);
+		if (ret)
+			ath11k_pcic_free_irq(ab);
+		return ret;
+	}
 
 	for (i = 0; i < ab->hw_params.ce_count; i++)
 		ab->irq_num[ATH11K_IRQ_CE0_OFFSET + i] = -1;
