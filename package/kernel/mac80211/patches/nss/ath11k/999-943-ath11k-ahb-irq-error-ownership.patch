Subject: ath11k: unwind AHB IRQ and NAPI setup failures

Adapt Linux 8ab38bbac02298e3fb03008ed4a0227485c0fd62. Preserve NSS ring
filtering, reject negative IRQ lookups, and keep only acquired ownership.
Original-commit: https://git.kernel.org/linus/8ab38bbac02298e3fb03008ed4a0227485c0fd62

--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -460,36 +460,53 @@
 	ab->qmi.service_ins_id += ab->userpd_id;
 }
 
+static void ath11k_ahb_free_ext_irq_grp(struct ath11k_base *ab,
+				      struct ath11k_ext_irq_grp *irq_grp)
+{
+	int j;
+
+	if (!irq_grp->napi_ndev)
+		return;
+
+	for (j = 0; j < irq_grp->num_irq; j++)
+		free_irq(ab->irq_num[irq_grp->irqs[j]], irq_grp);
+
+	netif_napi_del(&irq_grp->napi);
+	free_netdev(irq_grp->napi_ndev);
+	irq_grp->napi_ndev = NULL;
+	irq_grp->num_irq = 0;
+}
+
 static void ath11k_ahb_free_ext_irq(struct ath11k_base *ab)
 {
-	int i, j;
-
-	for (i = 0; i < ATH11K_EXT_IRQ_GRP_NUM_MAX; i++) {
-		struct ath11k_ext_irq_grp *irq_grp = &ab->ext_irq_grp[i];
-
-		for (j = 0; j < irq_grp->num_irq; j++)
-			free_irq(ab->irq_num[irq_grp->irqs[j]], irq_grp);
-
-		netif_napi_del(&irq_grp->napi);
-		free_netdev(irq_grp->napi_ndev);
-	}
-}
-
-static void ath11k_ahb_free_irq(struct ath11k_base *ab)
+	int i;
+
+	for (i = 0; i < ATH11K_EXT_IRQ_GRP_NUM_MAX; i++)
+		ath11k_ahb_free_ext_irq_grp(ab, &ab->ext_irq_grp[i]);
+}
+
+static void ath11k_ahb_free_ce_irqs(struct ath11k_base *ab, int max_idx)
 {
 	int irq_idx;
 	int i;
 
-	if (ab->hw_params.hybrid_bus_type)
-		return ath11k_pcic_free_irq(ab);
-
-	for (i = 0; i < ab->hw_params.ce_count; i++) {
