+
+static bool ath11k_qmi_cb_enter(struct ath11k_qmi *qmi)
+{
+	bool admitted = false;
+
+	if (!qmi->cb_initialized)
+		return false;
+
+	mutex_lock(&qmi->cb_lock);
+	if (!qmi->cb_closing) {
+		atomic_inc(&qmi->cb_active);
+		admitted = true;
+	}
+	mutex_unlock(&qmi->cb_lock);
+
+	return admitted;
 }
 
+static void ath11k_qmi_cb_leave(struct ath11k_qmi *qmi)
+{
+	if (!qmi->cb_initialized)
+		return;
+
+	if (atomic_dec_and_test(&qmi->cb_active))
+		wake_up_all(&qmi->cb_waitq);
+}
+
+static void ath11k_qmi_cb_close(struct ath11k_qmi *qmi)
+{
+	if (!qmi->cb_initialized)
+		return;
+
+	mutex_lock(&qmi->cb_lock);
+	qmi->cb_closing = true;
+	mutex_unlock(&qmi->cb_lock);
+
+	/* Wait for callbacks that already passed admission.  New callbacks
+	 * are rejected by cb_enter() while this waits.
+	 */
+	wait_event(qmi->cb_waitq, atomic_read(&qmi->cb_active) == 0);
+}
