+static void ath11k_qmi_driver_event_purge(struct ath11k_qmi *qmi)
+{
+	struct ath11k_qmi_driver_event *event, *tmp;
+	LIST_HEAD(purge);
+
+	spin_lock(&qmi->event_lock);
+	list_splice_init(&qmi->event_list, &purge);
+	spin_unlock(&qmi->event_lock);
+
+	list_for_each_entry_safe(event, tmp, &purge, list) {
+		list_del(&event->list);
+		kfree(event);
+	}
+}
+
 void ath11k_qmi_deinit_service(struct ath11k_base *ab)
 {
 	qmi_handle_release(&ab->qmi.handle);
 	cancel_work_sync(&ab->qmi.event_work);
+	ath11k_qmi_driver_event_purge(&ab->qmi);
 	destroy_workqueue(ab->qmi.event_wq);
 	ath11k_qmi_m3_free(ab);
 	ath11k_qmi_free_target_mem_chunk(ab);
