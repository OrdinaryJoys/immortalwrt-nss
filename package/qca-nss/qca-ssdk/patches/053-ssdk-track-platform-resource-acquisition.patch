 void
 ssdk_plat_exit(a_uint32_t dev_id)
 {
 /*qca808x_end*/
-	hsl_reg_mode reg_mode;
-#ifdef DESS
-	ssdk_reg_map_info map;
-#endif
-/*qca808x_start*/
-	SSDK_INFO("ssdk_plat_exit\n");
-/*qca808x_end*/
-	reg_mode = ssdk_switch_reg_access_mode_get(dev_id);
-	if (reg_mode == HSL_REG_LOCAL_BUS) {
-		struct clk *cmn_clk = NULL;
+	struct ssdk_plat_resources *resources;
+	struct qca_phy_priv *priv;
 
-		iounmap(qca_phy_priv_global[dev_id]->hw_addr);
-		cmn_clk = ssdk_dts_cmnclk_get(dev_id);
-		if (!IS_ERR(cmn_clk)) {
-#if defined(HPPE) || defined(MP)
-			ssdk_gcc_clock_exit();
-#endif
-		}
-	}
-
-#ifdef DESS
-	reg_mode = ssdk_psgmii_reg_access_mode_get(dev_id);
-	if (reg_mode == HSL_REG_LOCAL_BUS) {
-		ssdk_psgmii_reg_map_info_get(dev_id, &map);
-		iounmap(qca_phy_priv_global[dev_id]->psgmii_hw_addr);
-		release_mem_region(map.base_addr,
-                                        map.size);
-	}
-#endif
-#ifdef IN_UNIPHY
-	reg_mode = ssdk_uniphy_reg_access_mode_get(dev_id);
-	if (reg_mode == HSL_REG_LOCAL_BUS) {
-		iounmap(qca_phy_priv_global[dev_id]->uniphy_hw_addr);
-	}
-#endif
+	mutex_lock(&ssdk_plat_resource_lock);
+	if (dev_id >= SW_MAX_NR_DEV)
+		goto out;
+	resources = &ssdk_plat_resources[dev_id];
+	if (!resources->owner)
+		goto out;
+	if (!qca_phy_priv_global || dev_id >= ssdk_switch_device_num_get() ||
+	    qca_phy_priv_global[dev_id] != resources->owner)
+		goto foreign;
+	priv = resources->owner;
+	if (priv->hw_addr != resources->switch_base ||
+	    priv->uniphy_hw_addr != resources->uniphy ||
+	    priv->psgmii_hw_addr != resources->psgmii)
+		goto foreign;
+	priv->hw_addr = NULL;
+	priv->uniphy_hw_addr = NULL;
+	priv->psgmii_hw_addr = NULL;
+	ssdk_plat_release_resources(resources);
+	goto out;
+foreign:
