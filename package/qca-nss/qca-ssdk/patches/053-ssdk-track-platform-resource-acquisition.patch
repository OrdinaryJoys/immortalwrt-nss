Subject: [PATCH] ssdk: pair cold platform resources with their acquiring instance

Complete fallible mappings/regions before the void GCC initializer. Keep
publication private, unwind only acquired rights, and share module-global
GCC invocation until the last participant. Root/reader and nested clock
failure contracts are not qualified by this prerequisite layer.

--- a/src/init/ssdk_plat.c
+++ b/src/init/ssdk_plat.c
@@ -47,6 +47,7 @@
 #include <linux/delay.h>
 #include <linux/string.h>
 #include <linux/spinlock.h>
+#include <linux/mutex.h>
 #include <linux/bitops.h>
 #include <linux/mdio-bitbang.h>
 #include <net/dsa.h>
@@ -1993,128 +1994,190 @@
 	mutex_lock(&ssdk_sysfs_lock);
 	ssdk_sysfs_remove_locked();
 	mutex_unlock(&ssdk_sysfs_lock);
+}
+
+/* Cold root init/exit only; callers still own producer/reader quiescence. */
+struct ssdk_plat_resources {
+	struct qca_phy_priv *owner;
+	u8 __iomem *uniphy;
+	u8 __iomem *switch_base;
+	u8 __iomem *psgmii;
+	ssdk_reg_map_info psgmii_map;
+	bool psgmii_region;
+	struct clk *ess_clk;
+	bool ess_enabled;
+#if defined(HPPE) || defined(MP)
+	bool gcc;
+#endif
+};
+
+static DEFINE_MUTEX(ssdk_plat_resource_lock);
+static struct ssdk_plat_resources ssdk_plat_resources[SW_MAX_NR_DEV];
+#if defined(HPPE) || defined(MP)
+/* The zero-argument GCC helpers operate on module-global clock state. */
+static unsigned int ssdk_plat_gcc_users;
+#endif
+
+static void ssdk_plat_release_resources(struct ssdk_plat_resources *resources)
+{
+	if (resources->ess_enabled)
+		clk_disable_unprepare(resources->ess_clk);
+#if defined(HPPE) || defined(MP)
+	if (resources->gcc && --ssdk_plat_gcc_users == 0)
+		ssdk_gcc_clock_exit();
+#endif
+	if (resources->psgmii)
+		iounmap(resources->psgmii);
+	if (resources->psgmii_region)
+		release_mem_region(resources->psgmii_map.base_addr,
+			resources->psgmii_map.size);
+	if (resources->switch_base)
+		iounmap(resources->switch_base);
+	if (resources->uniphy)
+		iounmap(resources->uniphy);
+	memset(resources, 0, sizeof(*resources));
 }
 
