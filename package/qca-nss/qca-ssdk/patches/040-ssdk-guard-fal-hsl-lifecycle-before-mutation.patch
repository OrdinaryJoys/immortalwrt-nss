+
+sw_error_t hsl_dev_guard_end(hsl_dev_lifecycle_guard_t **guard)
+{
+    int dev_id;
+
+    if (!guard)
+        return SW_BAD_PTR;
+    dev_id = hsl_dev_guard_id(*guard);
+    if (dev_id < 0)
+        return SW_BAD_PTR;
+    switch ((*guard)->phase) {
+    case HSL_DEV_INIT_RESERVED:
+    case HSL_DEV_API_READY:
+    case HSL_DEV_INIT_POST:
+    case HSL_DEV_CLEAN_RESERVED:
+    case HSL_DEV_CLEAN_POST:
+        (*guard)->cfg = NULL;
+        (*guard)->phase = HSL_DEV_IDLE;
+        *guard = NULL;
+        return SW_OK;
+    default:
+        return SW_BAD_STATE;
+    }
+}
