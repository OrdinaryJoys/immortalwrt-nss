+    if (hsl_dev_guards[dev_id].phase != HSL_DEV_IDLE)
+        return SW_BUSY;
+    hsl_dev_guards[dev_id].phase = HSL_DEV_CLEAN_RESERVED;
+    *guard = &hsl_dev_guards[dev_id];
