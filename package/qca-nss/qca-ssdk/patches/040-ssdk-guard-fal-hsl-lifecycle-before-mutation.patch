+
+sw_error_t hsl_dev_cleanup_begin(a_uint32_t dev_id,
+    hsl_dev_lifecycle_guard_t **guard)
+{
+    HSL_DEV_ID_CHECK(dev_id);
+    if (!guard)
+        return SW_BAD_PTR;
+    if (*guard)
