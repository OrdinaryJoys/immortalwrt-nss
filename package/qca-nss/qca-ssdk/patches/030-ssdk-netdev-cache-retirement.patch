+
+static void ssdk_netdev_cache_remove(struct net_device *dev, bool stop)
+{
+	struct net_device *old[SW_MAX_NR_DEV * SW_MAX_NR_PORT + SSDK_NETDEV_SWITCH_NUM];
+	phy_info_t *phyinfo;
+	ssdk_netdev_switch_t *sw;
+	a_uint32_t d, p, n = 0;
+
+	spin_lock_bh(&ssdk_netdev_cache_lock);
+	if (!ssdk_netdev_cache_accepting) {
+		spin_unlock_bh(&ssdk_netdev_cache_lock);
+		return;
+	}
+	if (stop) {
+		ssdk_netdev_cache_accepting = false;
+		ssdk_netdev_cache_live = false;
+	}
+	for (d = 0; d < SW_MAX_NR_DEV; d++) {
+		phyinfo = hsl_phy_info_get(d);
+		if (!phyinfo)
+			continue;
+		for (p = 0; p < SW_MAX_NR_PORT; p++) {
+			if (phyinfo->netdev[p] && (stop || phyinfo->netdev[p] == dev)) {
+				old[n++] = phyinfo->netdev[p];
+				phyinfo->netdev[p] = NULL;
+				ssdk_netdev_names[d][p][0] = '\0';
+			}
+		}
+	}
+	for (p = 0; p < SSDK_NETDEV_SWITCH_NUM; p++) {
+		sw = ssdk_dts_netdev_switch_get(p);
+		if (sw->dev && (stop || sw->dev == dev)) {
+			old[n++] = sw->dev;
+			sw->dev = NULL;
+			ssdk_switch_names[p][0] = '\0';
+		}
+	}
+	spin_unlock_bh(&ssdk_netdev_cache_lock);
+	while (n)
+		dev_put(old[--n]);
 }
 
+void ssdk_netdev_cache_stop(void)
+{
+	ssdk_netdev_cache_remove(NULL, true);
+}
+
+void ssdk_netdev_cache_unregister(struct net_device *dev)
+{
+	if (dev)
+		ssdk_netdev_cache_remove(dev, false);
+}
+
+void ssdk_netdev_cache_rename(struct net_device *dev)
+{
+	phy_info_t *phyinfo;
+	ssdk_netdev_switch_t *sw;
+	a_uint32_t d, p;
+
+	if (!dev)
+		return;
+	spin_lock_bh(&ssdk_netdev_cache_lock);
+	if (!ssdk_netdev_cache_accepting)
+		goto out;
+	for (d = 0; d < SW_MAX_NR_DEV; d++) {
+		phyinfo = hsl_phy_info_get(d);
+		if (!phyinfo)
+			continue;
+		for (p = 0; p < SW_MAX_NR_PORT; p++)
+			if (phyinfo->netdev[p] == dev)
+				strscpy(ssdk_netdev_names[d][p], dev->name, IFNAMSIZ);
+	}
+	for (p = 0; p < SSDK_NETDEV_SWITCH_NUM; p++) {
+		sw = ssdk_dts_netdev_switch_get(p);
+		if (sw->dev == dev)
+			strscpy(ssdk_switch_names[p], dev->name, IFNAMSIZ);
+	}
+out:
+	spin_unlock_bh(&ssdk_netdev_cache_lock);
+}
+
+/* 1: owned snapshot; 0: never-managed legacy miss; -1: no fallback. */
+int ssdk_netdev_cache_name(a_uint32_t dev_id, a_uint32_t port_id,
+	char *name, size_t size)
+{
+	phy_info_t *phyinfo;
+	int ret = -1;
+
+	if (!name || size < IFNAMSIZ)
+		return -1;
+	name[0] = '\0';
+	if (dev_id >= SW_MAX_NR_DEV || port_id >= SW_MAX_NR_PORT)
+		return -1;
+	spin_lock_bh(&ssdk_netdev_cache_lock);
+	if (!ssdk_netdev_managed[dev_id][port_id]) {
+		ret = 0;
+	} else if (ssdk_netdev_cache_live) {
+		phyinfo = hsl_phy_info_get(dev_id);
+		if (phyinfo && phyinfo->netdev[port_id]) {
+			memcpy(name, ssdk_netdev_names[dev_id][port_id], IFNAMSIZ);
+			ret = 1;
+		}
+	}
+	spin_unlock_bh(&ssdk_netdev_cache_lock);
+	return ret;
+}
+
+int ssdk_netdev_cache_index(struct net_device *dev)
+{
+	ssdk_netdev_switch_t *sw;
+	int found = -1;
+	a_uint32_t p;
+
+	spin_lock_bh(&ssdk_netdev_cache_lock);
+	if (ssdk_netdev_cache_live && dev)
+		for (p = 0; p < SSDK_NETDEV_SWITCH_NUM; p++) {
+			sw = ssdk_dts_netdev_switch_get(p);
+			if (sw->dev == dev) {
+				found = p;
+				break;
+			}
+		}
+	spin_unlock_bh(&ssdk_netdev_cache_lock);
+	return found;
+}
