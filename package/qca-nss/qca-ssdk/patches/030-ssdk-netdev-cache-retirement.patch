+#if IS_ENABLED(CONFIG_NET_DSA)
+static struct net_device *ssdk_switch_netdev_get(a_uint32_t dev_id)
+{
+	ssdk_netdev_switch_t *sw;
+	struct net_device *dev = NULL;
+
+	spin_lock_bh(&ssdk_netdev_cache_lock);
+	if (ssdk_netdev_cache_live) {
+		sw = ssdk_dts_netdev_switch_find_by_devid(dev_id);
+		if (sw && sw->dev) {
+			dev = sw->dev;
+			dev_hold(dev);
+		}
+	}
+	spin_unlock_bh(&ssdk_netdev_cache_lock);
+	return dev;
+}
+#endif
