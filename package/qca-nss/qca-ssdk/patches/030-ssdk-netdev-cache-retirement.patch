+static void ssdk_switch_name_copy(a_uint32_t index, char *name)
+{
+	name[0] = '\0';
+	spin_lock_bh(&ssdk_netdev_cache_lock);
+	if (ssdk_netdev_cache_live && index < SSDK_NETDEV_SWITCH_NUM)
+		memcpy(name, ssdk_switch_names[index], IFNAMSIZ);
+	spin_unlock_bh(&ssdk_netdev_cache_lock);
+}
+
+sw_error_t ssdk_netdev_switch_init(struct net_device *dev)
+{
+	struct net_device *old[2];
+	ssdk_netdev_switch_t *sw;
+	a_uint32_t port_id, dev_id = 0, p, n = 0;
+	phy_info_t *phyinfo;
+	sw_error_t ret = SW_BAD_VALUE;
+
+	if (!dev)
+		return SW_BAD_VALUE;
+	port_id = ssdk_netdev_to_portid(dev);
+	if (port_id >= SW_MAX_NR_PORT)
+		return SW_BAD_VALUE;
+	spin_lock_bh(&ssdk_netdev_cache_lock);
+	if (!ssdk_netdev_cache_accepting)
+		goto out;
+	phyinfo = hsl_phy_info_get(dev_id);
+	if (!phyinfo || A_TRUE != hsl_port_prop_check(dev_id, port_id, HSL_PP_EXCL_CPU))
+		goto out;
+	if (phyinfo->netdev[port_id] != dev) {
+		dev_hold(dev);
+		if (phyinfo->netdev[port_id])
+			old[n++] = phyinfo->netdev[port_id];
+		phyinfo->netdev[port_id] = dev;
+	}
+	ssdk_netdev_managed[dev_id][port_id] = true;
+	strscpy(ssdk_netdev_names[dev_id][port_id], dev->name, IFNAMSIZ);
+	ret = SW_NOT_FOUND;
+	for (p = 0; p < SSDK_NETDEV_SWITCH_NUM; p++) {
+		sw = ssdk_dts_netdev_switch_get(p);
+		if (sw->switch_netdev_port != port_id)
+			continue;
+		if (sw->dev != dev) {
+			dev_hold(dev);
+			if (sw->dev)
+				old[n++] = sw->dev;
+			sw->dev = dev;
+		}
+		strscpy(ssdk_switch_names[p], dev->name, IFNAMSIZ);
+		ret = SW_OK;
+		break;
+	}
+out:
+	spin_unlock_bh(&ssdk_netdev_cache_lock);
+	while (n)
+		dev_put(old[--n]);
+	return ret;
+}
