+static void ssdk_netdev_notifier_register(void)
+{
+	if (ssdk_dev_notifier_owned)
+		return;
+	ssdk_netdev_cache_start();
+	ssdk_dev_notifier.notifier_call = ssdk_dev_event;
+	ssdk_dev_notifier.priority = 1;
+	ssdk_dev_notifier_error = register_netdevice_notifier(&ssdk_dev_notifier);
+	if (ssdk_dev_notifier_error) {
+		ssdk_dev_notifier_owned = false;
+		/* Replay rollback excludes its current failing device. */
+		ssdk_netdev_cache_stop();
+		SSDK_ERROR("optional netdev notifier registration failed (code: %d)\n",
+			ssdk_dev_notifier_error);
+		return;
+	}
+	ssdk_dev_notifier_owned = true;
+	ssdk_netdev_cache_commit();
 }
 
+static void ssdk_netdev_notifier_unregister(void)
+{
+	ssdk_netdev_cache_stop();
+	if (ssdk_dev_notifier_owned) {
+		unregister_netdevice_notifier(&ssdk_dev_notifier);
+		ssdk_dev_notifier_owned = false;
+	}
+}
