@@ -339,8 +339,64 @@
 
 /*qca808x_start*/
 sw_error_t
+sd_init_check(a_uint32_t dev_id, const ssdk_init_cfg *cfg)
+{
+    if (dev_id >= SW_MAX_NR_DEV)
+        return SW_BAD_PARAM;
+    if (!cfg)
+        return SW_BAD_PTR;
+
+    /* Borrowed providers cannot be replaced while bare readers may exist.
+     * Validate every field before publishing even a NULL-slot contribution.
+     */
+    if (cfg->reg_func.mdio_set && ssdk_mdio_set &&
+        cfg->reg_func.mdio_set != ssdk_mdio_set)
+        return SW_BUSY;
+    if (cfg->reg_func.mdio_get && ssdk_mdio_get &&
+        cfg->reg_func.mdio_get != ssdk_mdio_get)
+        return SW_BUSY;
+    if (cfg->reg_func.i2c_set && ssdk_i2c_set &&
+        cfg->reg_func.i2c_set != ssdk_i2c_set)
+        return SW_BUSY;
+    if (cfg->reg_func.i2c_get && ssdk_i2c_get &&
+        cfg->reg_func.i2c_get != ssdk_i2c_get)
+        return SW_BUSY;
+/*qca808x_end*/
+    if (cfg->reg_func.header_reg_set && ssdk_hdr_reg_set &&
+        cfg->reg_func.header_reg_set != ssdk_hdr_reg_set)
+        return SW_BUSY;
+    if (cfg->reg_func.header_reg_get && ssdk_hdr_reg_get &&
+        cfg->reg_func.header_reg_get != ssdk_hdr_reg_get)
+        return SW_BUSY;
+    if (cfg->reg_func.psgmii_reg_set && ssdk_psgmii_reg_set &&
+        cfg->reg_func.psgmii_reg_set != ssdk_psgmii_reg_set)
+        return SW_BUSY;
+    if (cfg->reg_func.psgmii_reg_get && ssdk_psgmii_reg_get &&
+        cfg->reg_func.psgmii_reg_get != ssdk_psgmii_reg_get)
+        return SW_BUSY;
+    if (cfg->reg_func.uniphy_reg_set && ssdk_uniphy_reg_set &&
+        cfg->reg_func.uniphy_reg_set != ssdk_uniphy_reg_set)
+        return SW_BUSY;
+    if (cfg->reg_func.uniphy_reg_get && ssdk_uniphy_reg_get &&
+        cfg->reg_func.uniphy_reg_get != ssdk_uniphy_reg_get)
+        return SW_BUSY;
+    if (cfg->reg_func.mii_reg_set && ssdk_mii_reg_set &&
+        cfg->reg_func.mii_reg_set != ssdk_mii_reg_set)
+        return SW_BUSY;
+    if (cfg->reg_func.mii_reg_get && ssdk_mii_reg_get &&
+        cfg->reg_func.mii_reg_get != ssdk_mii_reg_get)
+        return SW_BUSY;
+
+/*qca808x_start*/
+    return SW_OK;
+}
+
+sw_error_t
 sd_init(a_uint32_t dev_id, ssdk_init_cfg * cfg)
 {
+    sw_error_t rv = sd_init_check(dev_id, cfg);
+
+    SW_RTN_ON_ERROR(rv);
     if (NULL != cfg->reg_func.mdio_set)
     {
         ssdk_mdio_set = cfg->reg_func.mdio_set;
