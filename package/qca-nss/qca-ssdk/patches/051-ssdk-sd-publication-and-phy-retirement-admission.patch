     HSL_DEV_ID_CHECK(dev_id);
     if (hsl_dev_guards[dev_id].phase != HSL_DEV_IDLE)
         return SW_BUSY;
+    /* Reject a conflicting provider before FAL resets its API table. */
+    if (cfg) {
+        rv = sd_init_check(dev_id, cfg);
+        SW_RTN_ON_ERROR(rv);
+    }
     if (dev_ssdk_cfg[dev_id])
         return SW_ALREADY_EXIST;
