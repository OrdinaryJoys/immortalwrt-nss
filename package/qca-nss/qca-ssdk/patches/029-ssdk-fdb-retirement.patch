@@ -1197,29 +1254,53 @@
 void
 qca_fdb_sw_sync_work_stop(struct qca_phy_priv *priv, fal_pbmp_t port_map)
 {
-	if ((priv->version != QCA_VER_HPPE) && (priv->version != QCA_VER_APPE) &&
