+
+static bool qca_fdb_sw_sync_supported(struct qca_phy_priv *priv)
+{
+	return priv->version == QCA_VER_HPPE || priv->version == QCA_VER_APPE ||
+		priv->version == QCA_VER_MRPPE || priv->version == QCA_VER_MHT;
+}
+
+bool qca_fdb_sw_sync_enter(struct qca_phy_priv *priv)
+{
+	bool admitted = false;
+
+	if (!priv->fdb_work_initialized || !qca_fdb_sw_sync_supported(priv))
+		return false;
+	aos_lock_bh(&priv->fdb_sw_sync_lock);
+	if (priv->fdb_ready && !priv->fdb_stopping && !priv->fdb_draining) {
+		++priv->fdb_users;
+		admitted = true;
+	}
+	aos_unlock_bh(&priv->fdb_sw_sync_lock);
+	return admitted;
+}
+
+void qca_fdb_sw_sync_leave(struct qca_phy_priv *priv)
+{
+	bool drained;
+
+	aos_lock_bh(&priv->fdb_sw_sync_lock);
+	drained = --priv->fdb_users == 0;
+	if (drained)
+		wake_up_all(&priv->fdb_wait);
+	aos_unlock_bh(&priv->fdb_sw_sync_lock);
+}
 
 void
 qca_fdb_sw_sync_work_task(struct work_struct *work)
 {
 	struct qca_phy_priv *priv = container_of(work, struct qca_phy_priv,
 		fdb_sw_sync_dwork.work);
+	bool running;
 
+	aos_lock_bh(&priv->fdb_sw_sync_lock);
+	running = priv->fdb_polling_started && !priv->fdb_stopping &&
+		!priv->fdb_draining;
+	aos_unlock_bh(&priv->fdb_sw_sync_lock);
+	if (!running)
+		return;
+
 #ifdef IN_FDB
 	ref_fdb_sw_sync_task(priv);
 #endif
-	schedule_delayed_work(&priv->fdb_sw_sync_dwork,
-		msecs_to_jiffies(QCA_FDB_SW_SYNC_WORK_DELAY));
+	aos_lock_bh(&priv->fdb_sw_sync_lock);
+	if (priv->fdb_polling_started && !priv->fdb_stopping && !priv->fdb_draining)
+		schedule_delayed_work(&priv->fdb_sw_sync_dwork,
+			msecs_to_jiffies(QCA_FDB_SW_SYNC_WORK_DELAY));
+	aos_unlock_bh(&priv->fdb_sw_sync_lock);
 }
 
+void qca_fdb_sw_sync_work_setup(struct qca_phy_priv *priv)
+{
+	mutex_init(&priv->fdb_ctrl_lock);
+	aos_lock_init(&priv->fdb_sw_sync_lock);
+	init_waitqueue_head(&priv->fdb_wait);
+	INIT_LIST_HEAD(&priv->sw_fdb_tbl);
+	INIT_DELAYED_WORK(&priv->fdb_sw_sync_dwork, qca_fdb_sw_sync_work_task);
+	priv->fdb_work_initialized = true;
+}
+
