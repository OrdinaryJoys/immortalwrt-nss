+static void ssdk_fdb_retire_controls(void)
+{
+	a_uint32_t dev_id, dev_num;
+
+#ifdef IN_NETLINK
+	ssdk_genl_stop_controls();
+#endif
+	ssdk_sysfs_exit();
+	if (qca_phy_priv_global) {
+		dev_num = ssdk_switch_device_num_get();
+		for (dev_id = 0; dev_id < dev_num; ++dev_id) {
+			struct qca_phy_priv *priv = qca_phy_priv_global[dev_id];
+			if (!priv)
+				continue;
+			qca_intr_deinit(priv);
+			qca_fdb_sw_sync_work_fini(priv);
+		}
+	}
+#ifdef IN_NETLINK
+	/* Accepted FDB/IRQ notification producers have returned before unlink. */
+	ssdk_genl_deinit();
+#endif
 }
 
