+	aos_unlock_bh(&priv->fdb_sw_sync_lock);
+	cancel_delayed_work_sync(&priv->fdb_sw_sync_dwork);
+	wait_event(priv->fdb_wait, !READ_ONCE(priv->fdb_users));
 #ifdef IN_FDB
 	ref_fdb_sw_sync_reset(priv, port_map);
 #endif
-	SSDK_DEBUG("fdb_sw_sync_port_map 0x%x\n", priv->fdb_sw_sync_port_map);
+	aos_lock_bh(&priv->fdb_sw_sync_lock);
+	priv->fdb_draining = false;
+	if (!priv->fdb_stopping && priv->fdb_sw_sync_port_map) {
+		priv->fdb_polling_started = A_TRUE;
+		schedule_delayed_work(&priv->fdb_sw_sync_dwork,
+			msecs_to_jiffies(QCA_FDB_SW_SYNC_WORK_DELAY));
+	}
+	aos_unlock_bh(&priv->fdb_sw_sync_lock);
+	mutex_unlock(&priv->fdb_ctrl_lock);
 }
 
+void qca_fdb_sw_sync_work_fini(struct qca_phy_priv *priv)
+{
+	if (!priv->fdb_work_initialized)
+		return;
+	mutex_lock(&priv->fdb_ctrl_lock);
+	aos_lock_bh(&priv->fdb_sw_sync_lock);
+	priv->fdb_stopping = true;
+	priv->fdb_draining = true;
+	priv->fdb_polling_started = A_FALSE;
+	priv->fdb_sw_sync_port_map = 0;
+	aos_unlock_bh(&priv->fdb_sw_sync_lock);
+	cancel_delayed_work_sync(&priv->fdb_sw_sync_dwork);
+	wait_event(priv->fdb_wait, !READ_ONCE(priv->fdb_users));
+	/* Zero users can be observed before the final locked wake returns. */
+	aos_lock_bh(&priv->fdb_sw_sync_lock);
+	aos_unlock_bh(&priv->fdb_sw_sync_lock);
+#ifdef IN_FDB
+	ref_fdb_sw_sync_fini(priv);
+#endif
+	mutex_unlock(&priv->fdb_ctrl_lock);
+}
