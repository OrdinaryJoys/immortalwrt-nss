--- a/src/hsl/hsl_lock.c
+++ b/src/hsl/hsl_lock.c
@@ -16,11 +16,20 @@
 
 #include "sw.h"
 
+#if defined(KERNEL_MODULE) && defined(KVER32) && \
+    !defined(USER_MODE) && !defined(HSL_STANDALONG)
+/* Native Linux readers may arrive before, or outlive, a bootstrap retry. */
+DEFINE_MUTEX(sw_hsl_api_lock);
+#else
 aos_mutex_lock_t sw_hsl_api_lock;
+#endif
 
 sw_error_t
 hsl_api_lock_init(void)
 {
+#if !(defined(KERNEL_MODULE) && defined(KVER32) && \
+    !defined(USER_MODE) && !defined(HSL_STANDALONG))
     aos_mutex_lock_init(&sw_hsl_api_lock);
+#endif
     return SW_OK;
 }
