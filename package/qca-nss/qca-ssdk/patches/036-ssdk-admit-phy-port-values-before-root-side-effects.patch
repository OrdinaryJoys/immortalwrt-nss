+static int ssdk_dt_read_port_values(struct device_node *port_node,
+		struct ssdk_dt_port_values *values)
+{
+	a_uint32_t id, dac[2] = {0};
+	a_bool_t has_dac = A_FALSE;
+	int ret;
+
+	ret = of_property_read_u32(port_node, "port_id", &id);
+	if (ret)
+		return ret;
+	if (id >= SW_MAX_NR_PORT)
+		return -EINVAL;
+	if (of_find_property(port_node, "phy_dac", NULL)) {
+		ret = of_property_read_u32_array(port_node, "phy_dac", dac, 2);
+		if (ret)
+			return ret;
+		has_dac = A_TRUE;
+	}
+	values->id = id;
+	values->has_dac = has_dac;
+	values->dac.mdac = dac[0];
+	values->dac.edac = dac[1];
+	return 0;
+}
 
+static int ssdk_dt_validate_phy_ports(struct device_node *switch_node)
+{
+	struct device_node *phy_info_node, *port_node;
+	struct ssdk_dt_port_values values;
+	int ret = 0;
+
+	phy_info_node = of_get_child_by_name(switch_node, "qcom,port_phyinfo");
+	if (!phy_info_node)
+		return 0;
+	for_each_available_child_of_node(phy_info_node, port_node) {
+		ret = ssdk_dt_read_port_values(port_node, &values);
+		if (ret) {
+			of_node_put(port_node);
+			break;
+		}
+	}
+	of_node_put(phy_info_node);
+	return ret;
+}
