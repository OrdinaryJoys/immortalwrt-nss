From: AX6 lifecycle review
Subject: [PATCH] ssdk: fail closed on FAL and device initialization errors

diff --git a/src/init/ssdk_init.c b/src/init/ssdk_init.c
index fb979f8..3eb3874 100644
--- a/src/init/ssdk_init.c
+++ b/src/init/ssdk_init.c
@@ -1612,8 +1612,10 @@ ssdk_init(a_uint32_t dev_id, ssdk_init_cfg * cfg)
 	rv = sd_init_check(dev_id, cfg);
 	SW_RTN_ON_ERROR(rv);
 	rv = fal_init(dev_id, cfg);
-	if (rv != SW_OK)
+	if (rv != SW_OK) {
 		SSDK_ERROR("ssdk fal init failed: %d. \r\n", rv);
+		return rv;
+	}
 
 /*qca808x_end*/
 	if(!ssdk_is_emulation(dev_id))
@@ -2197,15 +2199,18 @@ static int __init regi_init(void)
 		qca_phy_priv_global[dev_id]->ports = SSDK_PHYSICAL_PORT7;
 /*qca808x_start*/
 		rv = ssdk_plat_init(&cfg, dev_id);
-		SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+		if (rv != SW_OK)
+			goto out;
 /*qca808x_end*/
 		ssdk_driver_register(dev_id);
 /*qca808x_start*/
 		rv = chip_ver_get(dev_id, &cfg);
-		SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+		if (rv != SW_OK)
+			goto out;
 
 		rv = ssdk_init(dev_id, &cfg);
-		SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+		if (rv != SW_OK)
+			goto out;
 /*qca808x_end*/
 
 
@@ -2217,7 +2222,8 @@ static int __init regi_init(void)
 				if (qca_phy_priv_global[dev_id]->of_node) {
 					qca_ar8327_gpio_reset(qca_phy_priv_global[dev_id]);
 					rv = ssdk_switch_register(dev_id, cfg.chip_type);
-					SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+					if (rv != SW_OK)
+			goto out;
 					rv = qca_ar8327_hw_init(qca_phy_priv_global[dev_id]);
 					SSDK_INFO("Initializing ISISC Done!!\n");
 				}
@@ -2227,9 +2233,11 @@ static int __init regi_init(void)
 #if defined(MHT)
 				qca_phy_priv_global[dev_id]->ports = SSDK_PHYSICAL_PORT6;
 				rv = qca_mht_hw_init(&cfg, dev_id);
-				SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+				if (rv != SW_OK)
+			goto out;
 				rv = ssdk_switch_register(dev_id, cfg.chip_type);
-				SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+				if (rv != SW_OK)
+			goto out;
 				SSDK_INFO("Initializing MHT Done!!\n");
 #endif
 				break;
@@ -2242,7 +2250,8 @@ static int __init regi_init(void)
 					qca_phy_priv_global[dev_id]->ports = SSDK_PHYSICAL_PORT3;
 				qca_appe_hw_init(dev_id);
 				rv = ssdk_switch_register(dev_id, cfg.chip_type);
-				SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+				if (rv != SW_OK)
+			goto out;
 				SSDK_INFO("Initializing %s Done!!\n", PPE_STR);
 #endif
 				break;
@@ -2250,7 +2259,8 @@ static int __init regi_init(void)
 #if defined(HPPE)
 				qca_hppe_hw_init(dev_id);
 				rv = ssdk_switch_register(dev_id, cfg.chip_type);
-				SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+				if (rv != SW_OK)
+			goto out;
 				SSDK_INFO("Initializing %s Done!!\n", PPE_STR);
 #endif
 				break;
@@ -2260,14 +2270,16 @@ static int __init regi_init(void)
 			case CHIP_SCOMPHY:
 #if defined(SCOMPHY)
 					rv = qca_scomphy_hw_init(&cfg, dev_id);
-					SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+					if (rv != SW_OK)
+			goto out;
 #if defined(MP)
 					if(cfg.phy_id == MP_GEPHY)
 					{
 						qca_phy_priv_global[dev_id]->ports =
 							SSDK_PHYSICAL_PORT3;
 						rv = ssdk_switch_register(dev_id, cfg.chip_type);
-						SW_CNTU_ON_ERROR_AND_COND1_OR_GOTO_OUT(rv, -ENODEV);
+						if (rv != SW_OK)
+			goto out;
 					}
 #endif
 					SSDK_INFO("Initializing SCOMPHY Done!!\n");
@@ -2296,13 +2308,9 @@ out:
 	if (rv == 0)
 		SSDK_INFO("qca-%s module init succeeded!\n", SSDK_STR);
 	else {
-		if (rv == -ENODEV) {
-			rv = 0;
-			SSDK_INFO("qca-%s module init, no device found!\n", SSDK_STR);
-		} else {
-			SSDK_INFO("qca-%s module init failed! (code: %d)\n", SSDK_STR, rv);
-			ssdk_free_priv();
-		}
+		/* Never convert a real initialization failure into success. */
+		SSDK_ERROR("qca-%s module init failed! (code: %d)\n", SSDK_STR, rv);
+		ssdk_free_priv();
 	}
 
 	return rv;
