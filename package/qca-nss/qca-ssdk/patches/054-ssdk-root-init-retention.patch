+
+/* Undo a pre-publication failure. Only stages whose inverse is proven are
+ * reachable here, and the order mirrors the serial order regi_exit() already
+ * uses for the same stages: the module-wide platform driver publication is
+ * removed first, then the PHY metadata published by ssdk_alloc_priv(), then the
+ * per-device platform MMIO/clock rights, and finally the private slots and the
+ * topology. dev_stage[] witnesses which devices were exposed to the platform
+ * stage; ssdk_plat_exit() is documented and modelled as a safe no-op for a
+ * device whose acquisition did not complete (its owner field is still NULL).
+ * FAL/PHY/switch producers were never started, so a negative module_init
+ * return leaves no module code referenced. */
+static void ssdk_root_abort_unpublished(a_uint32_t dev_num)
+{
+	a_uint32_t dev_id;
+	sw_error_t phy_rv;
+
+	ssdk_driver_unregister_owned();
+	for (dev_id = 0; dev_id < dev_num; dev_id++) {
+		phy_rv = ssdk_phy_driver_cleanup(dev_id);
+		if (phy_rv != SW_OK)
+			SSDK_ERROR("qca-%s device %u PHY metadata cleanup failed (code: %d)\n",
+				   SSDK_STR, dev_id, phy_rv);
+	}
+	for (dev_id = 0; dev_id < dev_num; dev_id++) {
+		if (ssdk_root.dev_stage[dev_id] >= SSDK_ROOT_STAGE_PLAT)
+			ssdk_plat_exit(dev_id);
+	}
+	ssdk_free_priv();
 }
 
