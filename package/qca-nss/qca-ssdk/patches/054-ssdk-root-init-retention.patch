Subject: [PATCH] ssdk: retain root init state and preserve the first error

Replace the withdrawn bare fail-closed return with an explicit root-init
contract. Pre-publication failures (topology, private slots/PHY metadata,
platform MMIO/clock, platform driver, chip probe) are unwound in the serial
order regi_exit() already uses for the same stages -- module-wide driver
publication, PHY metadata, per-device platform rights, private slots and
topology -- and may fail module init with an explicit errno. Post-publication
failures (FAL/PHY, HPPE/switch and per-device producers) are retained: module
init returns 0, only the first error is latched and logged, and the netdev
cache is withheld so qca-nss-dp fails closed instead of binding to a
half-initialized SSDK.

FAL keeps its own first error and PHY initialization is not attempted after a
FAL failure; the HPPE return becomes a required stage result. The platform
driver publication is module-wide and owned exactly once. ssdk_plat_init()
keeps its Linux errnos but its bare SW_FAIL becomes an honest -EIO. The
stage/dev_stage context is read back for log naming and abort scoping.
Sysfs/genl stay diagnostic-only: their failures are logged, never fatal and
never cache-gating. Netdev notifier failure is logged as the qca-nss-dp
netdev-cache contract violation. Work producers gain initialized guards so a
retained partial init can be unloaded without touching unstarted timers.

--- a/src/init/ssdk_init.c
+++ b/src/init/ssdk_init.c
@@ -113,7 +113,163 @@
 #ifdef IN_SFP_PHY
 #include "sfp_phy.h"
 #endif
+
+/* Root module-init context.
+ *
+ * A negative module_init result makes the kernel free the module without ever
+ * calling module_exit(). A failure may therefore only be fatal while every
+ * resource it leaves behind still has a proven inverse. The pre-publication
+ * stages (topology, private slots/PHY metadata, platform MMIO/clock, platform
+ * driver) have such inverses. From FAL/PHY initialization on, producers are
+ * published and the only safe outcome is retention: keep the module resident,
+ * preserve the first error and withhold the netdev cache so qca-nss-dp fails
+ * closed instead of binding to a half-initialized SSDK.
+ */
+enum ssdk_root_stage {
+	SSDK_ROOT_STAGE_NONE = 0,
+	SSDK_ROOT_STAGE_TOPOLOGY,
+	SSDK_ROOT_STAGE_PRIV,
+	SSDK_ROOT_STAGE_PLAT,
+	SSDK_ROOT_STAGE_DRIVER,
+	SSDK_ROOT_STAGE_CHIP,
+	SSDK_ROOT_STAGE_SDK,
+	SSDK_ROOT_STAGE_SWITCH,
+};
+
+enum ssdk_root_domain {
+	SSDK_ROOT_DOMAIN_SW = 0,
+	SSDK_ROOT_DOMAIN_LINUX,
+};
+
+struct ssdk_root_context {
+	enum ssdk_root_stage stage;
+	int first_err;
+	enum ssdk_root_stage first_stage;
+	enum ssdk_root_domain first_domain;
+	a_uint32_t first_dev_id;
+	a_uint32_t dev_initialized;
+	a_bool_t published;
+	a_bool_t no_device;
+	enum ssdk_root_stage dev_stage[SW_MAX_NR_DEV];
+};
+
+static struct ssdk_root_context ssdk_root;
+
+/* Producer idempotence flags: a retained partial init can be unloaded, so a
+ * stop function must not touch a work item whose init never ran. */
+static bool ssdk_mac_sw_sync_work_initialized[SW_MAX_NR_DEV];
+static bool ssdk_qm_err_check_work_initialized[SW_MAX_NR_DEV];
+
+#ifndef SSDK_STR
+#define SSDK_STR "ssdk"
+#endif
+
+static const char *ssdk_root_stage_name(enum ssdk_root_stage stage)
+{
+	switch (stage) {
+	case SSDK_ROOT_STAGE_NONE:
+		return "none";
+	case SSDK_ROOT_STAGE_TOPOLOGY:
+		return "topology";
+	case SSDK_ROOT_STAGE_PRIV:
+		return "priv";
+	case SSDK_ROOT_STAGE_PLAT:
+		return "plat";
+	case SSDK_ROOT_STAGE_DRIVER:
+		return "driver";
+	case SSDK_ROOT_STAGE_CHIP:
+		return "chip";
+	case SSDK_ROOT_STAGE_SDK:
+		return "sdk";
+	case SSDK_ROOT_STAGE_SWITCH:
+		return "switch";
+	default:
+		return "unknown";
+	}
+}
+
+/* A fresh init context, including the static producer state a retained load
+ * may leave behind. The stop paths read these flags, so a partial init must
+ * never inherit a stale "initialized" claim. */
+static void ssdk_root_reset(void)
+{
+	memset(&ssdk_root, 0, sizeof(ssdk_root));
+	memset(ssdk_mac_sw_sync_work_initialized, 0,
+	       sizeof(ssdk_mac_sw_sync_work_initialized));
+	memset(ssdk_qm_err_check_work_initialized, 0,
+	       sizeof(ssdk_qm_err_check_work_initialized));
+	ssdk_dev_notifier_error = 0;
+	ssdk_root.stage = SSDK_ROOT_STAGE_NONE;
+}
+
+/* Record the stage that is about to run. The abort path reads dev_stage[] to
+ * decide which devices were exposed to a stage; the logs read the module-level
+ * stage to name the retained/aborted context. */
+static void ssdk_root_stage_set(enum ssdk_root_stage stage, a_uint32_t dev_id)
+{
+	ssdk_root.stage = stage;
+	if (dev_id < SW_MAX_NR_DEV)
+		ssdk_root.dev_stage[dev_id] = stage;
+}
+
+/* Record only the first business error; later failures and cleanup errors must
+ * not overwrite the cause that explains the degraded state. */
+static void ssdk_root_latch(enum ssdk_root_stage stage, a_uint32_t dev_id,
+			    int err, enum ssdk_root_domain domain)
+{
+	if (err == 0 || ssdk_root.first_err)
+		return;
+	ssdk_root.first_err = err;
+	ssdk_root.first_stage = stage;
+	ssdk_root.first_domain = domain;
+	ssdk_root.first_dev_id = dev_id;
+}
+
+/* ssdk_plat_init() returns SW_FAIL for a mapping/region failure and explicit
+ * Linux errnos for argument/ownership rejections; only SW_FAIL needs the SSDK
+ * error domain so the abort cannot return the bare "-1". */
+static enum ssdk_root_domain ssdk_root_plat_domain(int err)
+{
+	return err == SW_FAIL ? SSDK_ROOT_DOMAIN_SW : SSDK_ROOT_DOMAIN_LINUX;
+}
+
+/* Convert the latched error into the negative errno returned by module_init.
+ * Linux-domain values are already errnos and are kept verbatim. SSDK values
+ * are mapped explicitly: SW_NOT_SUPPORTED (-19) must never be reported as a
+ * no-device error, because only chip_ver_get may mean "no device". */
+static int ssdk_root_errno(int err, enum ssdk_root_domain domain)
+{
+	int rv = 0;
 
+	if (err == SW_OK)
+		return 0;
+	if (domain == SSDK_ROOT_DOMAIN_LINUX) {
+		rv = err;
+	} else {
+		switch (err) {
+		case SW_NOT_SUPPORTED:
+			return -EOPNOTSUPP;
+		case SW_OUT_OF_MEM:
+			return -ENOMEM;
+		case SW_ALREADY_EXIST:
+			return -EEXIST;
+		case SW_BUSY:
+			return -EBUSY;
+		case SW_OUT_OF_RANGE:
+		case SW_BAD_VALUE:
+		case SW_BAD_PARAM:
+		case SW_BAD_PTR:
+		case SW_BAD_LEN:
+			return -EINVAL;
+		default:
+			return -EIO;
+		}
+	}
+	/* -ENODEV is reserved for chip_ver_get's "no device" sentinel: a module
+	 * init failure must never be misread as an absent switch. */
+	return rv == -ENODEV ? -EIO : rv;
+}
+
