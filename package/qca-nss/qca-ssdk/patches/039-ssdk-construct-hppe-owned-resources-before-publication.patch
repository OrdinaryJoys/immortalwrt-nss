     fal_pbmp_t dev_portmap;
@@ -34,6 +34,95 @@
 
 static port_info_t *p_port_info[SW_MAX_NR_DEV] = { 0 };
 
+sw_error_t
+hsl_port_prop_slot_available(a_uint32_t dev_id)
+{
+    HSL_DEV_ID_CHECK(dev_id);
+    return p_port_info[dev_id] ? SW_ALREADY_EXIST : SW_OK;
+}
+
+sw_error_t
+hsl_port_prop_build_alloc(a_uint32_t dev_id, hsl_port_prop_owner_t **owner)
+{
+    sw_error_t rv;
+    port_info_t *p_mem;
+
+    if (!owner)
+        return SW_BAD_PTR;
+    if (*owner)
+        return SW_BAD_STATE;
+    rv = hsl_port_prop_slot_available(dev_id);
+    SW_RTN_ON_ERROR(rv);
+
+    p_mem = aos_mem_alloc(sizeof(*p_mem));
+    if (!p_mem)
+        return SW_OUT_OF_MEM;
+    aos_mem_zero(p_mem, sizeof(*p_mem));
+    *owner = p_mem;
+    return SW_OK;
+}
+
+sw_error_t
+hsl_port_prop_build_portmap_set(hsl_port_prop_owner_t *owner, fal_port_t port_id)
+{
+    if (!owner)
+        return SW_BAD_PTR;
+    if (port_id >= SW_MAX_NR_PORT)
+        return SW_OUT_OF_RANGE;
+    SW_PBMP_ADD_PORT(owner->dev_portmap, port_id);
+    return SW_OK;
+}
+
+sw_error_t
+hsl_port_prop_build_set(hsl_port_prop_owner_t *owner, fal_port_t port_id,
+                        hsl_port_prop_t p_type)
+{
+    if (!owner)
+        return SW_BAD_PTR;
+    if (port_id >= SW_MAX_NR_PORT)
+        return SW_OUT_OF_RANGE;
+    if ((a_uint32_t)p_type >= HSL_PP_BUTT)
+        return SW_BAD_PARAM;
+    if (!SW_IS_PBMP_MEMBER(owner->dev_portmap, port_id))
+        return SW_OUT_OF_RANGE;
+    SW_PBMP_ADD_PORT(owner->property[p_type], port_id);
+    return SW_OK;
+}
+
+sw_error_t
+hsl_port_prop_build_publish(a_uint32_t dev_id, hsl_port_prop_owner_t **owner)
+{
+    sw_error_t rv;
+
+    if (!owner || !*owner)
+        return SW_BAD_PTR;
+    rv = hsl_port_prop_slot_available(dev_id);
+    SW_RTN_ON_ERROR(rv);
+    p_port_info[dev_id] = *owner;
+    *owner = NULL;
+    return SW_OK;
+}
+
+void
+hsl_port_prop_build_abort(hsl_port_prop_owner_t **owner)
+{
+    if (owner && *owner) {
+        aos_mem_free(*owner);
+        *owner = NULL;
+    }
+}
+
+sw_error_t
+hsl_port_prop_cleanup_owned(a_uint32_t dev_id, hsl_port_prop_owner_t *owner)
+{
+    HSL_DEV_ID_CHECK(dev_id);
+    if (!owner || p_port_info[dev_id] != owner)
+        return SW_BAD_STATE;
+    aos_mem_free(p_port_info[dev_id]);
+    p_port_info[dev_id] = NULL;
+    return SW_OK;
+}
+
