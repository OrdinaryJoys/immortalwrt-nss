Subject: [PATCH] mcs: bound control messages, own replies and validate source lists

--- a/mc_netlink.c
+++ b/mc_netlink.c
@@ -19,6 +19,9 @@
 #include <net/net_namespace.h>
 #include <net/sock.h>
 #include <linux/etherdevice.h>
