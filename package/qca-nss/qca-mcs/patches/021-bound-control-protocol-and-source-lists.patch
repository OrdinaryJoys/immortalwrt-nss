 static struct sock *mc_nl_sk = NULL;
 static __be32 event_pid = MC_INVALID_PID;
+
+static bool mc_control_protocol_valid(u32 protocol)
+{
+	if (protocol == htons(ETH_P_IP))
+		return true;
+#ifdef MC_SUPPORT_MLD
+	if (protocol == htons(ETH_P_IPV6))
+		return true;
+#endif
+	return false;
+}
+
+static bool mc_control_group_valid(const void *data)
+{
+	struct __mc_group group;
+
+	memcpy(&group, data, sizeof(group));
+	return mc_control_protocol_valid(group.pro);
+}
+
+static bool mc_control_interval_valid(u32 seconds)
+{
+	unsigned long ticks;
+
+	return !check_mul_overflow((unsigned long)seconds, (unsigned long)HZ, &ticks) &&
+		ticks <= MAX_JIFFY_OFFSET;
+}
+
+/* Validate every consumed field before any command can change shared state. */
+static bool mc_control_payload_valid(u32 type, const struct __mcctl_msg_header *hdr,
+				     const void *data, size_t available)
+{
+	size_t required = 0, unit = 0, i, j;
+
+	if (hdr->buf_len > available)
+		return false;
+	if (type != MC_MSG_SET_EVENT_PID &&
+	    (!hdr->if_name[0] || !memchr(hdr->if_name, '\0', IFNAMSIZ)))
+		return false;
+
+	switch (type) {
+	case MC_MSG_SET_ENABLE:
+	case MC_MSG_SET_DEBUG:
+	case MC_MSG_SET_POLICY:
+	case MC_MSG_SET_MEMBERSHIP_INTERVAL:
+	case MC_MSG_SET_CONVERT_ALL:
+	case MC_MSG_SET_M2I3_FILTER:
+	case MC_MSG_SET_TBIT:
+	case MC_MSG_SET_LOCAL_QUERY_INTERVAL:
+	case MC_MSG_SET_ROUTER:
+		required = sizeof(struct __mc_param_value);
+		break;
+	case MC_MSG_SET_RETAG:
+		required = sizeof(struct __mc_param_retag);
+		break;
+	case MC_MSG_SET_ROUTER_PORT:
+		required = sizeof(struct __mc_param_router_port);
+		break;
+	case MC_MSG_SET_ADD_ACL_RULE:
+		required = sizeof(struct __mc_param_acl_rule);
+		break;
+	case MC_MSG_SET_FLUSH_ACL_RULE:
+		required = sizeof(u32);
+		break;
+	case MC_MSG_SET_TIMEOUT:
+		required = sizeof(struct __mc_param_timeout);
+		break;
+	case MC_MSG_SET_EVENT_PID:
+		required = sizeof(struct __event_info);
+		break;
+	case MC_MSG_DEL_MDB:
+		required = sizeof(struct __mc_mdb_entry);
+		break;
+	case MC_MSG_SET_PSW_ENCAP:
+		unit = sizeof(struct __mc_encaptbl_entry);
+		break;
+	case MC_MSG_SET_PSW_FLOOD:
+		unit = sizeof(struct __mc_floodtbl_entry);
+		break;
+	case MC_MSG_SET_NOTIFY:
+		unit = sizeof(struct __mc_group);
+		break;
+	case MC_MSG_GET_ACL:
+	case MC_MSG_GET_MDB:
+	case MC_MSG_GET_ROUTER_PORT:
+		break;
+	default:
+		return false;
+	}
+
+	/* Legacy fixed SET callers may leave buf_len zero; actual bytes still count. */
+	if (available < required || (required && hdr->buf_len && hdr->buf_len < required) ||
+	    (unit && hdr->buf_len % unit))
+		return false;
+
+	switch (type) {
+	case MC_MSG_SET_EVENT_PID:
+		return ((const struct __event_info *)data)->event_pid != 0;
+	case MC_MSG_SET_POLICY:
+		return ((const struct __mc_param_value *)data)->val <= MC_POLICY_FLOOD;
+	case MC_MSG_SET_MEMBERSHIP_INTERVAL:
+	case MC_MSG_SET_LOCAL_QUERY_INTERVAL:
+		return mc_control_interval_valid(((const struct __mc_param_value *)data)->val);
+	case MC_MSG_SET_ROUTER_PORT:
+		return ((const struct __mc_param_router_port *)data)->type < MC_RTPORT_MAX;
+	case MC_MSG_SET_TIMEOUT:
+		return ((const struct __mc_param_timeout *)data)->from <=
+			MC_TIMEOUT_FROM_GROUP_MEMBERSHIP_INTERVAL;
+	case MC_MSG_SET_ADD_ACL_RULE:
+		if (((const struct __mc_param_acl_rule *)data)->pattern.rule >= MC_ACL_RULE_MAX)
+			return false;
+		fallthrough;
+	case MC_MSG_SET_FLUSH_ACL_RULE:
+		if (((const struct __mc_param_acl_rule *)data)->pattern_type == MC_ACL_PATTERN_IGMP)
+			return true;
+#ifdef MC_SUPPORT_MLD
+		return ((const struct __mc_param_acl_rule *)data)->pattern_type == MC_ACL_PATTERN_MLD;
+#else
+		return false;
+#endif
+	case MC_MSG_DEL_MDB:
+		return mc_control_group_valid(data);
+	case MC_MSG_SET_PSW_ENCAP:
+		for (i = 0; i < hdr->buf_len / unit; i++) {
+			const struct __mc_encaptbl_entry *entry =
+				(const void *)((const u8 *)data + i * unit);
+
+			if (!mc_control_group_valid(entry))
+				return false;
+			/* Keep the existing bounded outer-count clamp. */
+			for (j = 0; j < min_t(u32, entry->dev_cnt, MC_ENCAP_DEV_MAX); j++) {
+				if (entry->dev[j].in_nsrcs > MC_DEF_SRCS_MAX ||
+				    (entry->dev[j].ex_nsrcs != MC_DEF_EX_SRCS_INVAL &&
+				     entry->dev[j].ex_nsrcs > MC_DEF_SRCS_MAX))
+					return false;
+			}
+		}
+		break;
+	case MC_MSG_SET_PSW_FLOOD:
+	case MC_MSG_SET_NOTIFY:
+		for (i = 0; i < hdr->buf_len / unit; i++)
+			if (!mc_control_group_valid((const u8 *)data + i * unit))
+				return false;
+		break;
+	}
+	return true;
+}
