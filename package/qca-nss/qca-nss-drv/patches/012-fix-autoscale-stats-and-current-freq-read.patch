From: AX6 NSS fix chain
Subject: [PATCH] nss-drv: fix current_freq read + keep core stats on fixed frequency

Mechanical context refresh only, against exact DRV
6aa14c78e097b29c493ff2fef87e4d35906b2b5a plus current source
2e207fcae4479bc55211fb83395ae2954b39b951 patches 001-011.

The original 012 requires relaxed matching of trailing context which
anticipates a later core-readiness guard. This refresh is generated from
the actual pre/post-012 full trees. All central current_freq and frequency
stats changes are byte-identical to applying the original 012; no semantic
change or release-train update is intended. See full prepared-tree
equivalence evidence in driver-implementation.

diff --git a/nss_freq.c b/nss_freq.c
index 5357597..a4c8bd5 100644
--- a/nss_freq.c
+++ b/nss_freq.c
@@ -209,15 +209,6 @@ static void nss_freq_scale_frequency(struct nss_ctx_instance *nss_ctx, uint32_t
 	uint32_t maximum;
 	uint32_t index = nss_runtime_samples.freq_scale_index;
 
-	/*
-	 * We do not accept any statistics if auto scaling is off,
-	 * we start with a fresh sample set when scaling is
-	 * eventually turned on.
-	 */
-	if (!nss_cmd_buf.auto_scale && nss_runtime_samples.initialized) {
-		return;
-	}
-
 	/*
 	 * Delete Current Index Value, Add New Value, Recalculate new Sum, Shift Index
 	 */
@@ -232,12 +223,11 @@ static void nss_freq_scale_frequency(struct nss_ctx_instance *nss_ctx, uint32_t
 		nss_runtime_samples.sample_count++;
 
 		/*
-		 * Samples Are All Ready, Start Auto Scale
+		 * Samples are ready for reporting and, if enabled, scaling.
 		 */
 		if (nss_runtime_samples.sample_count == NSS_SAMPLE_BUFFER_SIZE ) {
-			nss_cmd_buf.auto_scale = 1;
-			nss_runtime_samples.freq_scale_ready = 1;
 			nss_runtime_samples.initialized = 1;
+			nss_runtime_samples.freq_scale_ready = 1;
 		}
 
 		return;
@@ -421,7 +411,13 @@ bool nss_freq_sched_change(nss_freq_scales_t index, bool auto_scale)
 
 	nss_work->frequency = nss_runtime_samples.freq_scale[index].frequency;
 
-	nss_work->stats_enable = auto_scale;
+	if (!auto_scale) {
+		nss_cmd_buf.auto_scale = 0;
+		nss_runtime_samples.freq_scale_ready = 0;
+	}
+
+	/* Keep NSS core stats enabled even when fixed-frequency scaling is requested. */
+	nss_work->stats_enable = 1;
 	nss_cmd_buf.current_freq = nss_work->frequency;
 	queue_work(nss_wq, (struct work_struct *)nss_work);
 
diff --git a/nss_init.c b/nss_init.c
index d050b15..4dd8e15 100644
--- a/nss_init.c
+++ b/nss_init.c
@@ -180,15 +180,15 @@ static int nss_current_freq_handler(const struct ctl_table *ctl, int write, void
 {
 	int ret, i;
 
-	BUG_ON(!nss_wq);
-
 	ret = proc_dointvec(ctl, write, buffer, lenp, ppos);
 
-	if (!*lenp || (*ppos && !write)) {
-		printk("Frequency Set to %d\n", nss_cmd_buf.current_freq);
-		*lenp = 0;
+	if (ret || !write || !*lenp)
 		return ret;
-	}
+
+	if (!nss_wq)
+		return ret;
+
+	printk("Frequency Set to %d\n", nss_cmd_buf.current_freq);
 
 	/*
 	 * Check if frequency exists in frequency Table
@@ -207,7 +207,8 @@ static int nss_current_freq_handler(const struct ctl_table *ctl, int write, void
 	}
 
 	/*
-	 * Turn off Auto Scale
+	 * Turn off frequency scaling, but keep NSS core stats enabled so
+	 * cpu_load_ubi keeps updating while running at a fixed frequency.
 	*/
 	nss_cmd_buf.auto_scale = 0;
 	nss_runtime_samples.freq_scale_ready = 0;
@@ -220,10 +221,10 @@ static int nss_current_freq_handler(const struct ctl_table *ctl, int write, void
 	}
 	INIT_WORK((struct work_struct *)nss_work, nss_hal_wq_function);
 	nss_work->frequency = nss_cmd_buf.current_freq;
-	nss_work->stats_enable = 0;
+	nss_work->stats_enable = 1;
 
 	/*
-	 * Ensure we start with a fresh set of samples later
+	 * Start the fixed-frequency stats window with a fresh sample set.
 	 */
 	nss_reset_frequency_stats_samples();
 
@@ -246,30 +247,40 @@ static int nss_auto_scale_handler(const struct ctl_table *ctl, int write, void _
 		return ret;
 	}
 
+	if (!write) {
+		return ret;
+	}
+
+	if (!nss_wq) {
+		return ret;
+	}
+
 	if (nss_cmd_buf.auto_scale != 1) {
 		/*
-		 * Is auto scaling currently enabled? If so, send the command to
-		 * disable stats reporting to NSS
+		 * Disable frequency scaling, but keep core stats reporting
+		 * enabled. HLOS gates scaling decisions with auto_scale; the
+		 * firmware stats stream is also used by cpu_load_ubi.
 		 */
-		if (nss_runtime_samples.freq_scale_ready != 0) {
-			nss_cmd_buf.current_freq = nss_runtime_samples.freq_scale[nss_runtime_samples.freq_scale_index].frequency;
-			nss_work = (nss_work_t *)kmalloc(sizeof(nss_work_t), GFP_ATOMIC);
-			if (!nss_work) {
-				nss_info("NSS Freq WQ kmalloc fail");
-				return ret;
-			}
-			INIT_WORK((struct work_struct *)nss_work, nss_hal_wq_function);
-			nss_work->frequency = nss_cmd_buf.current_freq;
-			nss_work->stats_enable = 0;
-			queue_work(nss_wq, (struct work_struct *)nss_work);
-			nss_runtime_samples.freq_scale_ready = 0;
-
-			/*
-			 * The current samples would be stale later when scaling is
-			 * enabled again, hence reset them
-			 */
-			nss_reset_frequency_stats_samples();
+		nss_cmd_buf.auto_scale = 0;
+		nss_cmd_buf.current_freq = nss_runtime_samples.freq_scale[nss_runtime_samples.freq_scale_index].frequency;
+
+		nss_work = (nss_work_t *)kmalloc(sizeof(nss_work_t), GFP_ATOMIC);
+		if (!nss_work) {
+			nss_info("NSS Freq WQ kmalloc fail");
+			return ret;
 		}
+
+		INIT_WORK((struct work_struct *)nss_work, nss_hal_wq_function);
+		nss_work->frequency = nss_cmd_buf.current_freq;
+		nss_work->stats_enable = 1;
+		queue_work(nss_wq, (struct work_struct *)nss_work);
+		nss_runtime_samples.freq_scale_ready = 0;
+
+		/*
+		 * Keep collecting fixed-frequency samples from a clean window.
+		 */
+		nss_reset_frequency_stats_samples();
+
 		return ret;
 	}
 
@@ -279,6 +290,7 @@ static int nss_auto_scale_handler(const struct ctl_table *ctl, int write, void _
 	nss_runtime_samples.freq_scale_index = 1;
 	nss_runtime_samples.sample_count = 0;
 	nss_runtime_samples.initialized = 0;
+	nss_runtime_samples.freq_scale_ready = 0;
 	nss_cmd_buf.current_freq = nss_runtime_samples.freq_scale[nss_runtime_samples.freq_scale_index].frequency;
 
 	nss_work = (nss_work_t *)kmalloc(sizeof(nss_work_t), GFP_ATOMIC);
@@ -291,8 +303,7 @@ static int nss_auto_scale_handler(const struct ctl_table *ctl, int write, void _
 	nss_work->stats_enable = 1;
 	queue_work(nss_wq, (struct work_struct *)nss_work);
 
-	nss_cmd_buf.auto_scale = 0;
-	nss_runtime_samples.freq_scale_ready = 1;
+	nss_cmd_buf.auto_scale = 1;
 
 	return ret;
 }
