Subject: [PATCH] nss: allocate probe dummy before acquiring NSS resources

Allocate the unpublished dummy netdev before common reset or per-core
resource acquisition. Allocation failure can then return -ENOMEM without
first publishing meminfo or acquiring managed NSS providers.

Keep the dummy local until the old allocation point. Free only that local
owner on preceding failures; after transfer, preserve existing IRQ cleanup.
This closes this allocation-failure window, not later probe rollback or the
broader FW/DMA/provider lifetime. Driver-core still performs failed-probe
cleanup for its own pre-callback resources.

--- a/nss_hal/nss_hal.c
+++ b/nss_hal/nss_hal.c
@@ -289,28 +289,36 @@
 	struct nss_top_instance *nss_top = &nss_top_main;
 	struct nss_ctx_instance *nss_ctx = NULL;
 	struct nss_platform_data *npd = NULL;
+	struct net_device *napi_ndev;
 	int i, err = 0;
 #ifdef NSS_DRV_TSTAMP_ENABLE
 	struct net_device *tstamp_ndev = NULL;
 #endif
 
+	napi_ndev = alloc_netdev_dummy(0);
+	if (!napi_ndev)
+		return -ENOMEM;
+
 	if (nss_top_main.nss_hal_common_init_done == false) {
 		err = nss_top->hal_ops->common_reset(nss_dev);
 		if (err) {
 			nss_info_always("NSS HAL common init failed\n");
-			return -EFAULT;
+			err = -EFAULT;
+			goto err_free_napi;
 		}
 	}
 
 #if (NSS_DT_SUPPORT == 1)
 	if (!nss_dev->dev.of_node) {
 		pr_err("nss-driver: Device tree not available\n");
-		return -ENODEV;
+		err = -ENODEV;
+		goto err_free_napi;
 	}
 
 	npd = nss_top->hal_ops->of_get_pdata(nss_dev);
 	if (!npd) {
-		return -EFAULT;
+		err = -EFAULT;
+		goto err_free_napi;
 	}
 
 	nss_ctx = &nss_top->nss[npd->id];
@@ -391,11 +399,10 @@
 	}
 
 	/*
-	 * Initialize the dummy netdevice.
+	 * Transfer the dummy netdevice to the IRQ cleanup owner.
 	 */
-	nss_ctx->napi_ndev = alloc_netdev_dummy(0);
-	if (!nss_ctx->napi_ndev)
-		goto err_init;
+	nss_ctx->napi_ndev = napi_ndev;
+	napi_ndev = NULL;
 
 	for (i = 0; i < npd->num_irq; i++) {
 		err = nss_hal_register_irq(nss_ctx, npd, NSS_CTX_NAPI_NDEV(nss_ctx), i);
@@ -911,6 +918,9 @@
 	if (nss_dev->dev.of_node) {
 		devm_kfree(&nss_dev->dev, npd);
 	}
+err_free_napi:
+	if (napi_ndev)
+		free_netdev(napi_ndev);
 	return err;
 }
 
