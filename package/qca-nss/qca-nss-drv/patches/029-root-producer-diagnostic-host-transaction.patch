+
+void nss_fw_coredump_notify(struct nss_ctx_instance *nss_own, int intr)
+{
+	if (!nss_coredump_begin())
+		return;
+
+	nss_fw_coredump_notify_active(nss_own, intr);
+	nss_coredump_end();
+}
+
+bool nss_coredump_request(struct nss_ctx_instance *ctx)
+{
+	bool sent = false;
+
+	if (!ctx || !nss_coredump_begin())
+		return false;
+
+	if (!nss_coredump_can_send(ctx))
+		goto out;
+	nss_hal_send_interrupt(ctx, NSS_H2N_INTR_TRIGGER_COREDUMP);
+	sent = true;
+out:
+	nss_coredump_end();
+	return sent;
+}
