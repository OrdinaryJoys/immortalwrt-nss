@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef __NSS_FREQ_WORK_H
+#define __NSS_FREQ_WORK_H
+
+#include <linux/list.h>
+#include <linux/workqueue.h>
+
+struct task_struct;
+
+/* Original zero-initialized lexical token; do not copy or transfer tasks. */
+struct nss_freq_work_reader {
+	struct list_head node;
+	struct task_struct *task;
+	struct workqueue_struct *queue;
+};
+
+/*
+ * Non-NMI producers only. The original lexical token must remain live until
+ * end, with begin/enqueue/end on the same task; it is not a transferable ref.
+ * Close rejects new begin calls but permits admitted producers to enqueue.
+ */
+bool nss_freq_work_begin(struct nss_freq_work_reader *reader);
+void nss_freq_work_end(struct nss_freq_work_reader *reader);
+/*
+ * Submit only a fresh, initialized, caller-owned work item. True transfers it
+ * to the worker (which may run immediately); false leaves it with the caller.
+ */
+bool nss_freq_work_enqueue(struct nss_freq_work_reader *reader,
+		struct work_struct *work);
+/*
+ * Work must be initialized with nss_freq_work_run. Under the receipt gate,
+ * queue first, then invoke commit(data) synchronously only on success, before
+ * allowing the run shim into HAL. No config side effects on false. Commit may
+ * use call-local data but must not sleep, reenter this API, release its token
+ * or free the submitted work. This gate does not serialize RX/ACK state.
+ */
+bool nss_freq_work_enqueue_commit(struct nss_freq_work_reader *reader,
+		struct work_struct *work, void (*commit)(void *), void *data);
+/* Gate barrier only; always run the original HAL worker for accepted work. */
+void nss_freq_work_run(struct work_struct *work);
+/*
+ * Process lifecycle only, never inside a producer or this queue's worker and
+ * never under locks needed by those callbacks. Quiesce closes admission and
+ * joins producers, their final wake and queued host work while core/clock/PM
+ * resources remain live; exit releases the queue. Init returns -EBUSY for a
+ * live owner, including after quiesce; only exit permits another init.
+ * These scopes do not pin module text, join external callers or prove FW idle.
+ */
+int nss_freq_work_init(void);
+void nss_freq_work_quiesce(void);
+void nss_freq_work_exit(void);
+
+static inline void nss_freq_work_cleanup(struct nss_freq_work_reader *reader)
+{
+	if (reader->queue)
+		nss_freq_work_end(reader);
+}
