 /*
- * nss_coredump_notify_register()
- *	API for nss_init to register coredump notifier to panic chain
+ * nss_coredump_init()
+ *	Acquire the queue before publishing the notifier or notify admission.
  */
-void nss_coredump_notify_register(void)
+int nss_coredump_init(void)
 {
-	atomic_notifier_chain_register(&panic_notifier_list, &nss_panic_nb);
+	unsigned long flags;
+	int ret;
+
+	mutex_lock(&coredump_lifecycle_lock);
+	if (coredump_workqueue) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	INIT_DELAYED_WORK(&coredump_queuewait, nss_coredump_wait);
+	coredump_workqueue = create_singlethread_workqueue("coredump_wait");
+	if (!coredump_workqueue) {
+		nss_warning("can't create coredump wait queue\n");
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	ret = atomic_notifier_chain_register(&panic_notifier_list, &nss_panic_nb);
+	if (ret) {
+		destroy_workqueue(coredump_workqueue);
+		coredump_workqueue = NULL;
+		goto out;
+	}
+	coredump_notifier_registered = true;
+	spin_lock_irqsave(&coredump_gate_lock, flags);
+	coredump_accepting = true;
+	spin_unlock_irqrestore(&coredump_gate_lock, flags);
+out:
+	mutex_unlock(&coredump_lifecycle_lock);
+	return ret;
 }
 
+/* Lifecycle lock held; no callback acquires it. All joins run without RTNL. */
+static void __nss_coredump_quiesce(void)
+{
+	unsigned long flags;
+
+	if (!coredump_workqueue)
+		return;
+
+	spin_lock_irqsave(&coredump_gate_lock, flags);
+	coredump_accepting = false;
+	spin_unlock_irqrestore(&coredump_gate_lock, flags);
+
+	if (coredump_notifier_registered) {
+		/* Atomic unregister includes the RCU join of panic callbacks. */
+		atomic_notifier_chain_unregister(&panic_notifier_list, &nss_panic_nb);
+		coredump_notifier_registered = false;
+	}
+	wait_event(coredump_idle, !atomic_read(&coredump_active));
+	/* Join the final decrement/wake before cancelling or destroying resources. */
+	spin_lock_irqsave(&coredump_gate_lock, flags);
+	spin_unlock_irqrestore(&coredump_gate_lock, flags);
+	cancel_delayed_work_sync(&coredump_queuewait);
+}
+
+void nss_coredump_quiesce(void)
+{
+	mutex_lock(&coredump_lifecycle_lock);
+	__nss_coredump_quiesce();
+	mutex_unlock(&coredump_lifecycle_lock);
+}
+
+void nss_coredump_exit(void)
+{
+	mutex_lock(&coredump_lifecycle_lock);
+	__nss_coredump_quiesce();
+	if (coredump_workqueue) {
+		destroy_workqueue(coredump_workqueue);
+		coredump_workqueue = NULL;
+	}
+	mutex_unlock(&coredump_lifecycle_lock);
+}
