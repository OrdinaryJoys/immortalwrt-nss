+static DEFINE_MUTEX(coredump_lifecycle_lock);
+static DEFINE_SPINLOCK(coredump_gate_lock);
+static DECLARE_WAIT_QUEUE_HEAD(coredump_idle);
+static atomic_t coredump_active = ATOMIC_INIT(0);
+static bool coredump_accepting;
+static bool coredump_notifier_registered;
 
 /*
+ * This count protects component resources, not callback code lifetime. The
+ * caller must still join all IRQ/NAPI callers before module text retirement.
+ */
+static bool nss_coredump_begin(void)
+{
+	unsigned long flags;
+	bool admitted = false;
+
+	spin_lock_irqsave(&coredump_gate_lock, flags);
+	if (coredump_accepting) {
+		atomic_inc(&coredump_active);
+		admitted = true;
+	}
+	spin_unlock_irqrestore(&coredump_gate_lock, flags);
+	return admitted;
+}
+
+static void nss_coredump_end(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&coredump_gate_lock, flags);
+	if (atomic_dec_and_test(&coredump_active))
+		wake_up_all(&coredump_idle);
+	spin_unlock_irqrestore(&coredump_gate_lock, flags);
+}
+
+/* Presence check only; root must keep mappings live through all caller joins. */
+static bool nss_coredump_can_send(struct nss_ctx_instance *ctx)
+{
+	if (!ctx || ctx->id >= NSS_MAX_CORES || ctx->id >= nss_top_main.num_nss ||
+			!READ_ONCE(ctx->nmap))
+		return false;
+#if defined(NSS_HAL_IPQ807x_SUPPORT) || defined(NSS_HAL_IPQ60XX_SUPPORT) || \
+	defined(NSS_HAL_IPQ50XX_SUPPORT) || defined(NSS_HAL_IPQ95XX_SUPPORT)
+	if (!READ_ONCE(ctx->qgic_map))
+		return false;
+#endif
+	return true;
+}
