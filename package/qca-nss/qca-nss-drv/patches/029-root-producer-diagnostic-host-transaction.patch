+/* SPDX-License-Identifier: ISC */
+#ifndef __NSS_COREDUMP_H
+#define __NSS_COREDUMP_H
+
+#include <linux/types.h>
+
+struct nss_ctx_instance;
+
+/*
+ * Process-context lifecycle only, never under RTNL or callback-required locks.
+ * Initialize before publishing core/IRQ producers. Quiesce before retiring any
+ * core MMIO, device or DMA/log resources; exit releases the owned workqueue.
+ * Quiesce/exit may sleep. Duplicate init fails, including after quiesce alone.
+ * Init returns -ENOMEM, -EBUSY or the notifier registration errno on failure;
+ * a failed init owns no new queue or notifier. Only exit permits another init.
+ *
+ * Quiesce closes notify/request admission, unregisters/RCU-joins the panic
+ * notifier, joins admitted notify/request bodies and their final wake, then
+ * synchronously cancels delayed work. The delayed callback is joined by cancel,
+ * not the active count; a callback already executing panic need not return.
+ *
+ * Active notify/request accounting is not a module code pin: callers must
+ * separately retire/join IRQ/NAPI and sysctl callers before module text
+ * retirement. Raw MMIO producers must be scoped or joined before core resource
+ * retirement. These APIs do not establish FW/DMA idle.
+ */
+int nss_coredump_init(void);
+void nss_coredump_quiesce(void);
+void nss_coredump_exit(void);
+
+/*
+ * Non-NMI callers must supply a live core context. True means one admitted H2N
+ * request was sent, not FW receipt/completion. False also covers an unready or
+ * invalid core, not only closed admission. Notify callers are IRQ/NAPI owners.
+ * Mapping-presence checks do not serialize probe/remove or pin those mappings.
+ */
+bool nss_coredump_request(struct nss_ctx_instance *ctx);
+void nss_fw_coredump_notify(struct nss_ctx_instance *nss_own, int intr);
+
+#endif /* __NSS_COREDUMP_H */
