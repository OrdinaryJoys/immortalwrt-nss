index 8764a92..826824f 100644
--- a/nss_core.c
+++ b/nss_core.c
@@ -2549,6 +2549,10 @@ int nss_core_handle_napi_emergency(struct napi_struct *napi, int budget)
 				int_ctx->nss_ctx->id, int_ctx->cause);
 	nss_fw_coredump_notify(int_ctx->nss_ctx, 0);
 
+#ifdef NSS_HAL_IPQ807x_SUPPORT
+	/* A returning notify must release NAPI ownership; never rearm crash IRQ. */
+	napi_complete(napi);
+#endif
 	return 0;
 }
 
