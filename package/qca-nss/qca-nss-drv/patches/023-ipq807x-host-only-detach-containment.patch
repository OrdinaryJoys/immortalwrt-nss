+	spin_lock_irqsave(&nss_data_plane_registration_lock, flags);
+	nss_data_plane_work_initialized = true;
+	nss_data_plane_workqueue = workqueue;
+	spin_unlock_irqrestore(&nss_data_plane_registration_lock, flags);
+out:
+	mutex_unlock(&nss_data_plane_work_lifecycle_lock);
+	return ret;
+#else
 	nss_data_plane_workqueue = create_singlethread_workqueue("nss_data_plane_workqueue");
