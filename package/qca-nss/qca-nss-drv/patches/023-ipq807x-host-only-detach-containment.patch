  */
 void nss_data_plane_destroy_delay_work(void)
 {
+#ifdef NSS_HAL_IPQ807x_SUPPORT
+	struct workqueue_struct *workqueue;
+	unsigned long flags;
+
+	nss_data_plane_stop_registration();
+	mutex_lock(&nss_data_plane_work_lifecycle_lock);
+	spin_lock_irqsave(&nss_data_plane_registration_lock, flags);
+	workqueue = nss_data_plane_workqueue;
+	nss_data_plane_workqueue = NULL;
+	spin_unlock_irqrestore(&nss_data_plane_registration_lock, flags);
+	if (workqueue)
+		destroy_workqueue(workqueue);
+	mutex_unlock(&nss_data_plane_work_lifecycle_lock);
+#else
 	destroy_workqueue(nss_data_plane_workqueue);
+#endif
 }
