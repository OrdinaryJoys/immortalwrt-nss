+int nss_hal_probe(struct platform_device *nss_dev)
+{
+#ifdef NSS_HAL_IPQ807x_SUPPORT
+	int ret;
+
+	/* No late probe may recreate a receive IRQ after the first group drain. */
+	mutex_lock(&nss_hal_receive_group_lock);
+	if (nss_hal_receive_group_closing)
+		ret = -ESHUTDOWN;
+	else
+		ret = __nss_hal_probe(nss_dev);
+	mutex_unlock(&nss_hal_receive_group_lock);
+	return ret;
+#else
+	return __nss_hal_probe(nss_dev);
+#endif
+}
+
+#ifdef NSS_HAL_IPQ807x_SUPPORT
+/* Caller holds the group mutex, never RTNL or an admitted DP/NAPI callback. */
+static void nss_hal_quiesce_receive_group(void)
+{
+	struct nss_top_instance *nss_top = &nss_top_main;
+	int core, i;
+
+	if (nss_hal_receive_group_stopped)
+		return;
+	nss_hal_receive_group_closing = true;
+#ifdef NSS_DATA_PLANE_GENERIC_SUPPORT
+	/* An admitted worker may need RTNL and live ACK RX; cancel outside RTNL. */
+	nss_data_plane_stop_registration();
+	rtnl_lock();
+	/* Host-only quarantine: no NSS close/deinit, no registry/ndpp clearing. */
+	nss_data_plane_quarantine_registered();
+	rtnl_unlock();
+#endif
+
+	/*
+	 * A descriptor can select another core's subsys_dp registry.  Stop every
+	 * active receiver before clearing ANY registry or freeing core resources.
+	 */
+	for (core = 0; core < NSS_MAX_CORES; core++) {
+		struct nss_ctx_instance *nss_ctx = &nss_top->nss[core];
+
+		for (i = 0; i < NSS_MAX_IRQ_PER_CORE; i++) {
+			if (!nss_ctx->int_ctx[i].irq)
+				continue;
+			nss_hal_disable_interrupt(nss_ctx,
+					nss_ctx->int_ctx[i].shift_factor,
+					NSS_HAL_SUPPORTED_INTERRUPTS);
+			nss_hal_clean_up_irq(&nss_ctx->int_ctx[i]);
+		}
+	}
+#ifdef NSS_DATA_PLANE_GENERIC_SUPPORT
+	/* The wrapper holds RTNL; all RX readers and DP readers are already gone. */
+	nss_top->data_plane_ops->data_plane_unregister();
+#endif
+	nss_hal_receive_group_stopped = true;
+}
+#endif
