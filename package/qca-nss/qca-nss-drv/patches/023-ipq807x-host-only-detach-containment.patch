 int nss_data_plane_init_delay_work(void)
 {
+#ifdef NSS_HAL_IPQ807x_SUPPORT
+	struct workqueue_struct *workqueue;
+	unsigned long flags;
+	int ret = 0;
+
+	mutex_lock(&nss_data_plane_work_lifecycle_lock);
+	spin_lock_irqsave(&nss_data_plane_registration_lock, flags);
+	if (nss_data_plane_registration_closing)
+		ret = -ESHUTDOWN;
+	else if (nss_data_plane_workqueue)
