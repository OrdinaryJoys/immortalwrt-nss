+	if (!ctx)
+		ctx = reg->ndev;
 
 	/*
 	 * call wifili msg callback
@@ -573,6 +578,10 @@
 			|| (if_num == NSS_WIFILI_EXTERNAL_INTERFACE1));
 
 	nss_info("nss_register_wifili_if if_num %d wifictx %px", if_num, netdev);
+
+	if (if_num >= NSS_MAX_NET_INTERFACES ||
+	    smp_load_acquire(&nss_ctx->subsys_dp_register[if_num].wifili_ctx))
+		return NULL;
 
 	nss_core_register_subsys_dp(nss_ctx, if_num, wifili_callback, wifili_ext_callback, NULL, netdev, features);
 
@@ -581,7 +590,26 @@
 	return (struct nss_ctx_instance *)&nss_top_main.nss[nss_top_main.wifi_handler_id];
 }
 EXPORT_SYMBOL(nss_register_wifili_if);
+
+struct nss_ctx_instance *nss_register_wifili_if_ctx(uint32_t if_num,
+		nss_wifili_ctx_callback_t ext_cb, nss_wifili_msg_callback_t msg_cb,
+		void *context, uint32_t features)
+{
+	struct nss_ctx_instance *nss_ctx = &nss_top_main.nss[nss_top_main.wifi_handler_id];
+
+	if (if_num != NSS_WIFILI_INTERNAL_INTERFACE &&
+	    if_num != NSS_WIFILI_EXTERNAL_INTERFACE0 &&
+	    if_num != NSS_WIFILI_EXTERNAL_INTERFACE1)
+		return NULL;
+
+	if (!nss_core_register_wifili_ctx(nss_ctx, if_num, ext_cb, msg_cb,
+					context, features))
+		return NULL;
 
+	return nss_ctx;
+}
+EXPORT_SYMBOL(nss_register_wifili_if_ctx);
+
 /*
  * nss_unregister_wifili_if()
  *	Unregister wifili with nss driver
@@ -618,12 +646,30 @@
 	nss_assert(nss_is_dynamic_interface(if_num));
 	nss_info("nss_register_wifili_if if_num %d wifictx %px", if_num, netdev);
 
+	if (if_num >= NSS_MAX_NET_INTERFACES ||
+	    smp_load_acquire(&nss_ctx->subsys_dp_register[if_num].wifili_ctx))
+		return NULL;
+
 	nss_core_register_subsys_dp(nss_ctx, if_num, wifili_callback, wifili_ext_callback, NULL, netdev, features);
 
 	return (struct nss_ctx_instance *)&nss_top_main.nss[nss_top_main.wifi_handler_id];
 }
 EXPORT_SYMBOL(nss_register_wifili_radio_if);
 
+struct nss_ctx_instance *nss_register_wifili_radio_if_ctx(uint32_t if_num,
+		void *context, uint32_t features)
+{
+	struct nss_ctx_instance *nss_ctx = &nss_top_main.nss[nss_top_main.wifi_handler_id];
+
+	if (!nss_is_dynamic_interface(if_num) ||
+	    !nss_core_register_wifili_ctx(nss_ctx, if_num, NULL, NULL,
+					context, features))
+		return NULL;
+
+	return nss_ctx;
+}
+EXPORT_SYMBOL(nss_register_wifili_radio_if_ctx);
+
