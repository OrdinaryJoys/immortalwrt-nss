--- a/exports/nss_wifili_if.h
+++ b/exports/nss_wifili_if.h
@@ -2190,6 +2190,22 @@
  * void
  */
 typedef void (*nss_wifili_callback_t)(struct net_device *netdev, struct sk_buff *skb, struct napi_struct *napi);
+
+/* Host-only opaque registrations never expose context as a net_device. */
+typedef void (*nss_wifili_ctx_callback_t)(void *context, struct sk_buff *skb,
+					struct napi_struct *napi);
+
+/*
+ * No lifetime barrier is provided by registration or unregistration. The
+ * caller must serialize registry changes and quiesce in-flight callbacks
+ * before unregistering/freeing ctx.
+ * features declares SG/FRAGLIST support of the opaque extended callback.
+ */
+struct nss_ctx_instance *nss_register_wifili_if_ctx(uint32_t if_num,
+		nss_wifili_ctx_callback_t ext_cb, nss_wifili_msg_callback_t msg_cb,
+		void *context, uint32_t features);
+struct nss_ctx_instance *nss_register_wifili_radio_if_ctx(uint32_t if_num,
+		void *context, uint32_t features);
 
