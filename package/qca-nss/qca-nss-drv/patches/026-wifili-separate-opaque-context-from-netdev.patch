From: AX6 local correctness review <local@localhost>
Subject: [PATCH] nss: separate WIFILI opaque owners from legacy netdevices

Keep legacy netdevice callbacks and dynamic features unchanged. New host-only
WIFILI registrations carry explicit context and per-owner notify callbacks.
No FW message layout or callback-drain/DMA-stop guarantee is added.

--- a/nss_core.c
+++ b/nss_core.c
@@ -318,7 +318,7 @@
 	/*
 	 * Check if there is already a subsystem registered at this interface number.
 	 */
-	BUG_ON(reg->ndev && reg->ndev != ndev);
+	BUG_ON(reg->wifili_ctx || (reg->ndev && reg->ndev != ndev));
 
 	reg->type = type;
 }
@@ -361,7 +361,7 @@
 	/*
 	 * Check if there is already a subsystem registered at this interface number.
 	 */
-	BUG_ON(reg->ndev && reg->ndev != ndev);
+	BUG_ON(reg->wifili_ctx || (reg->ndev && reg->ndev != ndev));
 
 	reg->cb = cb;
 	reg->ext_cb = ext_cb;
@@ -387,6 +387,10 @@
 
 	reg = &nss_ctx->subsys_dp_register[if_num];
 
+	/* Caller must already have quiesced callbacks; clearing is not a drain. */
+	smp_store_release(&reg->wifili_ctx, NULL);
+	reg->wifili_ext_cb = NULL;
+	reg->wifili_msg_cb = NULL;
 	reg->cb = NULL;
 	reg->ext_cb = NULL;
 	reg->app_data = NULL;
@@ -952,8 +956,32 @@
 }
 
 /*
+ * nss_core_register_wifili_ctx()
+ *	Register a host-only object. Callers serialize registry updates.
+ */
+bool nss_core_register_wifili_ctx(struct nss_ctx_instance *nss_ctx,
+		uint32_t if_num, nss_wifili_ctx_callback_t ext_cb,
+		nss_wifili_msg_callback_t msg_cb, void *context, uint32_t features)
+{
+	struct nss_subsystem_dataplane_register *reg;
+
+	if (if_num >= NSS_MAX_NET_INTERFACES || !context)
+		return false;
+
+	reg = &nss_ctx->subsys_dp_register[if_num];
+	if (reg->ndev || smp_load_acquire(&reg->wifili_ctx))
+		return false;
+
+	reg->features = features;
+	reg->wifili_ext_cb = ext_cb;
+	reg->wifili_msg_cb = msg_cb;
+	smp_store_release(&reg->wifili_ctx, context);
+	return true;
+}
+
+/*
  * nss_core_handle_ext_buffer_pkt()
- *	Handle Extended data plane packet received on physical or virtual interface.
+ *	Handle extended data on real netdevices or explicitly opaque WIFILI owners.
  */
 static inline void nss_core_handle_ext_buffer_pkt(struct nss_ctx_instance *nss_ctx,
 						unsigned int interface_num,
@@ -965,6 +993,8 @@
 	struct nss_subsystem_dataplane_register *subsys_dp_reg = &nss_ctx->subsys_dp_register[interface_num];
 	struct net_device *ndev = NULL;
 	nss_phys_if_rx_ext_data_callback_t ext_cb;
+	nss_wifili_ctx_callback_t ctx_cb;
+	void *context;
 
 	NSS_PKT_STATS_INC(&nss_top->stats_drv[NSS_DRV_STATS_RX_EXT_PACKET]);
 
@@ -976,6 +1006,21 @@
 		nbuf->ip_summed = CHECKSUM_NONE;
 	}
 
+	context = smp_load_acquire(&subsys_dp_reg->wifili_ctx);
+	if (context) {
+		ctx_cb = READ_ONCE(subsys_dp_reg->wifili_ext_cb);
+		if (!ctx_cb)
+			goto drop;
+
+		if (unlikely(skb_is_nonlinear(nbuf)) &&
+		    nss_core_skb_needs_linearize(nbuf, READ_ONCE(subsys_dp_reg->features)) &&
+		    __skb_linearize(nbuf))
+			goto drop;
+
+		ctx_cb(context, nbuf, napi);
+		return;
+	}
+
 	ndev = subsys_dp_reg->ndev;
 	ext_cb = subsys_dp_reg->ext_cb;
 	if (likely(ext_cb) && likely(ndev)) {
@@ -991,9 +1036,11 @@
 		}
 
 		ext_cb(ndev, (void *)nbuf, napi);
-	} else {
-		dev_kfree_skb_any(nbuf);
+		return;
 	}
+
+drop:
+	dev_kfree_skb_any(nbuf);
 }
 
