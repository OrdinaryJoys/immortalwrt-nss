new file mode 100644
index 0000000..c2d68d7
--- /dev/null
+++ b/nss_conn_table.c
@@ -0,0 +1,432 @@
+/* SPDX-License-Identifier: BSD-2-Clause OR GPL-2.0-only */
+#include <linux/dma-mapping.h>
+#include <linux/mm.h>
+#include <linux/wait.h>
+#include "nss_core.h"
+#include "nss_tx_rx_common.h"
+#include "nss_conn_table.h"
+
+enum nss_conn_phase {
+	NSS_CONN_IDLE,
+	NSS_CONN_SIZE,
+	NSS_CONN_PREPARING,
+	NSS_CONN_CFG_SENDING,
+	NSS_CONN_CFG,
+	NSS_CONN_ACTIVE,
+	NSS_CONN_UNCERTAIN,
+	NSS_CONN_ROLLBACK,
+};
+
+struct nss_conn_dma {
+	struct device *dev;
+	unsigned long cpu;
+	dma_addr_t dma;
+	size_t len;
+	unsigned int order;
+	enum dma_data_direction direction;
+	bool mapped;
+};
+
+struct nss_conn_request {
+	enum nss_conn_phase phase;
+	struct nss_ctx_instance *ctx;
+	nss_ptr_t token;
+	unsigned int requested;
+	unsigned int accepted;
+	bool early_cfg_reply;
+	bool early_cfg_accepted;
+	struct nss_conn_dma dma[2];
+};
+
+struct nss_conn_family {
+	unsigned int slot;
+	unsigned int size;
+	unsigned int cfg;
+};
+
+/* SIZE and CFG both use three words after the common header. */
+struct nss_conn_wire {
+	struct nss_cmn_msg cm;
+	u32 count;
+	u32 ce;
+	u32 cme;
+};
+
+/* The compiled profile remains the host cap before a dynamic ACK. */
+#define NSS_CONN_BASE_COUNT ((NSS_DEFAULT_NUM_CONN < NSS_FW_DEFAULT_NUM_CONN) ? \
+			    NSS_DEFAULT_NUM_CONN : NSS_FW_DEFAULT_NUM_CONN)
+
+static DEFINE_SPINLOCK(nss_conn_lock);
+static DECLARE_WAIT_QUEUE_HEAD(nss_conn_idle);
+static bool nss_conn_closing;
+static unsigned int nss_conn_users;
+/* Other host protocols already use scalar u32 app_data values. */
+static u32 nss_conn_token;
+static struct nss_conn_request nss_conn_tables[2] = {
+#ifdef NSS_DRV_IPV4_ENABLE
+	[0].accepted = NSS_CONN_BASE_COUNT,
+#endif
+#ifdef NSS_DRV_IPV6_ENABLE
+	[1].accepted = NSS_CONN_BASE_COUNT,
+#endif
+};
+
+static const struct nss_conn_family *nss_conn_family(unsigned int iface)
+{
+#ifdef NSS_DRV_IPV4_ENABLE
+	static const struct nss_conn_family v4 = {
+		0, NSS_IPV4_TX_CONN_TABLE_SIZE_MSG, NSS_IPV4_TX_CONN_CFG_RULE_MSG,
+	};
+#endif
+#ifdef NSS_DRV_IPV6_ENABLE
+	static const struct nss_conn_family v6 = {
+		1, NSS_IPV6_TX_CONN_TABLE_SIZE_MSG, NSS_IPV6_TX_CONN_CFG_RULE_MSG,
+	};
+#endif
+
+#ifdef NSS_DRV_IPV4_ENABLE
+	if (iface == NSS_IPV4_RX_INTERFACE)
+		return &v4;
+#endif
+#ifdef NSS_DRV_IPV6_ENABLE
+	if (iface == NSS_IPV6_RX_INTERFACE)
+		return &v6;
+#endif
+	return NULL;
+}
+
+bool nss_conn_table_message(const struct nss_cmn_msg *ncm)
+{
+	const struct nss_conn_family *family = nss_conn_family(ncm->interface);
+
+	return family && (ncm->type == family->size || ncm->type == family->cfg);
+}
+
+static void nss_conn_put(void)
+{
+	spin_lock_bh(&nss_conn_lock);
+	if (!--nss_conn_users)
+		wake_up_all(&nss_conn_idle);
+	spin_unlock_bh(&nss_conn_lock);
+}
+
+static bool nss_conn_valid_len(struct device *dev, u32 len)
+{
+	return len && len <= dma_max_mapping_size(dev) && get_order(len) <= MAX_PAGE_ORDER;
+}
+
+static int nss_conn_alloc(struct nss_conn_dma *record, struct device *dev,
+			  u32 len)
+{
+	record->dev = dev;
+	record->len = len;
+	record->order = get_order(len);
+	record->direction = DMA_TO_DEVICE;
+	record->cpu = __get_free_pages(GFP_ATOMIC | __GFP_NOWARN | __GFP_ZERO,
+				       record->order);
+	if (!record->cpu)
+		return -ENOMEM;
+	return 0;
+}
+
+static int nss_conn_map(struct nss_conn_dma *record)
+{
+	record->dma = dma_map_single(record->dev, (void *)record->cpu,
+				     record->len, record->direction);
+	if (dma_mapping_error(record->dev, record->dma))
+		return -EIO;
+
+	record->mapped = true;
+	/* Both the wire address and the last byte must fit the FW window. */
+	if (record->dma > U32_MAX || record->len - 1 > U32_MAX - record->dma)
+		return -ERANGE;
+	return 0;
+}
+
+static void nss_conn_undo(struct nss_conn_dma dma[2])
+{
+	int i;
+
+	for (i = 1; i >= 0; i--)
+		if (dma[i].mapped)
+			dma_unmap_single(dma[i].dev, dma[i].dma,
+					 dma[i].len, dma[i].direction);
+	for (i = 1; i >= 0; i--)
+		if (dma[i].cpu)
+			free_pages(dma[i].cpu, dma[i].order);
+}
+
+static int nss_conn_send(struct nss_ctx_instance *ctx, unsigned int iface,
+			 unsigned int type, nss_ptr_t token, unsigned int count,
+			 const struct nss_conn_dma *dma)
+{
+	struct nss_conn_wire msg = {};
+	const unsigned int payload = 3 * sizeof(u32);
+
+	/* Assert the common wire view against both vendor message layouts. */
+#ifdef NSS_DRV_IPV4_ENABLE
+	BUILD_BUG_ON(offsetof(struct nss_ipv4_msg, msg) != offsetof(struct nss_conn_wire, count));
+	BUILD_BUG_ON(sizeof(struct nss_ipv4_rule_conn_get_table_size_msg) != 3 * sizeof(u32));
+	BUILD_BUG_ON(sizeof(struct nss_ipv4_rule_conn_cfg_msg) != 3 * sizeof(u32));
+#endif
+#ifdef NSS_DRV_IPV6_ENABLE
+	BUILD_BUG_ON(offsetof(struct nss_ipv6_msg, msg) != offsetof(struct nss_conn_wire, count));
+	BUILD_BUG_ON(sizeof(struct nss_ipv6_rule_conn_get_table_size_msg) != 3 * sizeof(u32));
+	BUILD_BUG_ON(sizeof(struct nss_ipv6_rule_conn_cfg_msg) != 3 * sizeof(u32));
+#endif
+	nss_cmn_msg_init(&msg.cm, iface, type, payload, NULL, (void *)(unsigned long)token);
+	msg.count = htonl(count);
+	if (dma) {
+		msg.ce = (u32)dma[0].dma;
+		msg.cme = (u32)dma[1].dma;
+	}
+	return nss_core_send_conn_cmd(ctx, &msg.cm, sizeof(msg.cm) + payload);
+}
+
+static void nss_conn_reset(struct nss_conn_request *req)
+{
+	req->phase = NSS_CONN_IDLE;
+	req->token = 0;
+	req->ctx = NULL;
+	req->requested = 0;
+	req->early_cfg_reply = false;
+	req->early_cfg_accepted = false;
+}
+
+int nss_conn_table_start(struct nss_ctx_instance *ctx, unsigned int iface, int count)
+{
+	const struct nss_conn_family *family = nss_conn_family(iface);
+	struct nss_conn_request *req, *other;
+	unsigned int reserved;
+	nss_ptr_t token;
+	int ret;
+
+	if (!family)
+		return -EINVAL;
+
+	req = &nss_conn_tables[family->slot];
+	other = &nss_conn_tables[family->slot ^ 1];
+	spin_lock_bh(&nss_conn_lock);
+	if (nss_conn_closing) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	if (req->phase != NSS_CONN_IDLE) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	/* The default shortcut is not a FW reconfiguration or retirement. */
+	if (count == NSS_FW_DEFAULT_NUM_CONN) {
+		ret = 0;
+		goto unlock;
+	}
+	reserved = max(other->accepted, other->requested);
+	if (count < NSS_MIN_NUM_CONN || (count & NSS_NUM_CONN_QUANTA_MASK) ||
+	    (u32)count > NSS_MAX_TOTAL_NUM_CONN_IPV4_IPV6 ||
+	    reserved > NSS_MAX_TOTAL_NUM_CONN_IPV4_IPV6 - (u32)count) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	if (nss_conn_token == U32_MAX) {
+		ret = -EOVERFLOW;
+		goto unlock;
+	}
+	token = ++nss_conn_token;
+	req->ctx = ctx;
+	req->requested = count;
+	req->token = token;
+	req->phase = NSS_CONN_SIZE;
+	nss_conn_users++;
+	spin_unlock_bh(&nss_conn_lock);
+
+	ret = nss_conn_send(ctx, iface, family->size, token, count, NULL);
+	if (ret != NSS_TX_SUCCESS) {
+		spin_lock_bh(&nss_conn_lock);
+		if (req->token == token && req->phase == NSS_CONN_SIZE)
+			nss_conn_reset(req);
+		spin_unlock_bh(&nss_conn_lock);
+	}
+	nss_conn_put();
+	if (ret == NSS_TX_SUCCESS)
+		return 0;
+	return ret == NSS_TX_FAILURE_QUEUE ? -ENOSPC : -EIO;
+
+unlock:
+	spin_unlock_bh(&nss_conn_lock);
+	return ret;
+}
+
+static void nss_conn_configure(struct nss_conn_request *req,
+			       struct nss_ctx_instance *ctx,
+			       const struct nss_conn_family *family,
+			       unsigned int iface, nss_ptr_t token,
+			       unsigned int count, u32 ce_len, u32 cme_len)
+{
+	struct nss_conn_dma dma[2] = {};
+	int ret;
+
+	if (!nss_conn_valid_len(ctx->dev, ce_len) || !nss_conn_valid_len(ctx->dev, cme_len)) {
+		ret = -EINVAL;
+		goto undo;
+	}
+
+	ret = nss_conn_alloc(&dma[0], ctx->dev, ce_len);
+	if (ret)
+		goto undo;
+	ret = nss_conn_alloc(&dma[1], ctx->dev, cme_len);
+	if (ret)
+		goto undo;
+	ret = nss_conn_map(&dma[0]);
+	if (ret)
+		goto undo;
+	ret = nss_conn_map(&dma[1]);
+	if (ret)
+		goto undo;
+
+	spin_lock_bh(&nss_conn_lock);
+	if (nss_conn_closing) {
+		spin_unlock_bh(&nss_conn_lock);
+		ret = -ESHUTDOWN;
+		goto undo;
+	}
+	/* Install records before TX: the response can arrive inside send. */
+	memcpy(req->dma, dma, sizeof(dma));
+	req->phase = NSS_CONN_CFG_SENDING;
+	spin_unlock_bh(&nss_conn_lock);
+
+	ret = nss_conn_send(ctx, iface, family->cfg, token, count, dma);
+	spin_lock_bh(&nss_conn_lock);
+	if (ret == NSS_TX_SUCCESS) {
+		if (!req->early_cfg_reply) {
+			req->phase = NSS_CONN_CFG;
+		} else if (req->early_cfg_accepted) {
+			WRITE_ONCE(req->accepted, count);
+			req->phase = NSS_CONN_ACTIVE;
+		} else {
+			req->phase = NSS_CONN_UNCERTAIN;
+		}
+		spin_unlock_bh(&nss_conn_lock);
+		return;
+	}
+	/* A reply is not a publication receipt. Definite TX failure wins. */
+	req->phase = NSS_CONN_ROLLBACK;
+	memset(req->dma, 0, sizeof(req->dma));
+	spin_unlock_bh(&nss_conn_lock);
+	ret = ret == NSS_TX_FAILURE_QUEUE ? -ENOSPC : -EIO;
+undo:
+	nss_conn_undo(dma);
+	spin_lock_bh(&nss_conn_lock);
+	nss_conn_reset(req);
+	spin_unlock_bh(&nss_conn_lock);
+	nss_warning("%px: connection table interface %u private setup failed: %d\n",
+		    ctx, iface, ret);
+}
+
+void nss_conn_table_rx(struct nss_ctx_instance *ctx, const struct nss_cmn_msg *ncm)
+{
+	const struct nss_conn_family *family = nss_conn_family(ncm->interface);
+	struct nss_conn_request *req;
+	u32 count, ce_len, cme_len;
+	bool ack;
+
+	/* Core has bounded the actual contiguous extent before dispatch. */
+	if (!family || !nss_conn_table_message(ncm) ||
+	    (unsigned int)ncm->response >= NSS_CMN_RESPONSE_NOTIFY)
+		return;
+	ack = ncm->response == NSS_CMN_RESPONSE_ACK;
+	if (ack && ncm->len < (ncm->type == family->size ? 3 : 1) * sizeof(u32))
+		return;
+
+	req = &nss_conn_tables[family->slot];
+	spin_lock_bh(&nss_conn_lock);
+	if (nss_conn_closing || req->ctx != ctx || !ncm->app_data ||
+	    req->token != ncm->app_data)
+		goto unlock;
+
+	/* Count is the first word of both immutable family payload layouts. */
+	if (ack) {
+		__be32 wire_count;
+
+		memcpy(&wire_count, ncm + 1, sizeof(wire_count));
+		count = ntohl(wire_count);
+	} else {
+		count = 0;
+	}
+	if (ncm->type == family->cfg && req->phase == NSS_CONN_CFG_SENDING) {
+		if (!req->early_cfg_reply) {
+			req->early_cfg_reply = true;
+			req->early_cfg_accepted = ack && count == req->requested;
+		}
+		goto unlock;
+	}
+	if (ncm->type == family->cfg && req->phase == NSS_CONN_CFG) {
+		if (ack && count == req->requested) {
+			WRITE_ONCE(req->accepted, count);
+			req->phase = NSS_CONN_ACTIVE;
+		} else {
+			/* Neither a NACK nor a malformed ACK retires FW DMA. */
+			req->phase = NSS_CONN_UNCERTAIN;
+			nss_warning("%px: interface %u CFG response %u error %u; retaining FW-visible tables\n",
+				    ctx, ncm->interface, ncm->response, ncm->error);
+		}
+		goto unlock;
+	}
+
+	if (ncm->type != family->size || req->phase != NSS_CONN_SIZE)
+		goto unlock;
+	if (!ack || count != req->requested) {
+		nss_warning("%px: interface %u SIZE response %u error %u rejected\n",
+			    ctx, ncm->interface, ncm->response, ncm->error);
+		nss_conn_reset(req);
+		goto unlock;
+	}
+	{
+		__be32 lengths[2];
+
+		memcpy(lengths, (const u8 *)(ncm + 1) + sizeof(u32), sizeof(lengths));
+		ce_len = ntohl(lengths[0]);
+		cme_len = ntohl(lengths[1]);
+	}
+	req->phase = NSS_CONN_PREPARING;
+	nss_conn_users++;
+	spin_unlock_bh(&nss_conn_lock);
+	nss_conn_configure(req, ctx, family, ncm->interface, ncm->app_data,
+			   count, ce_len, cme_len);
+	nss_conn_put();
+	return;
+
+unlock:
+	spin_unlock_bh(&nss_conn_lock);
+}
+
+int nss_conn_table_count(unsigned int iface)
+{
+	const struct nss_conn_family *family = nss_conn_family(iface);
+
+	return family ? READ_ONCE(nss_conn_tables[family->slot].accepted) : 0;
+}
+
+void nss_conn_table_close(void)
+{
+	bool retained = false;
+	int i;
+
+	spin_lock_bh(&nss_conn_lock);
+	nss_conn_closing = true;
+	spin_unlock_bh(&nss_conn_lock);
+	wait_event(nss_conn_idle, !READ_ONCE(nss_conn_users));
+
+	spin_lock_bh(&nss_conn_lock);
+	for (i = 0; i < ARRAY_SIZE(nss_conn_tables); i++) {
+		struct nss_conn_request *req = &nss_conn_tables[i];
+
+		if (req->phase == NSS_CONN_SIZE)
+			nss_conn_reset(req);
+		if (req->phase == NSS_CONN_CFG || req->phase == NSS_CONN_ACTIVE ||
+		    req->phase == NSS_CONN_UNCERTAIN)
+			retained = true;
+	}
+	spin_unlock_bh(&nss_conn_lock);
+	if (retained)
+		pr_warn_once("NSS: FW retirement unknown; connection table mappings retained\n");
+}
