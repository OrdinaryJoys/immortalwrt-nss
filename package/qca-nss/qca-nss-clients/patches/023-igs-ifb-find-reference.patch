 	if (!nss_ifb_down(ifb_info)) {
 		nss_igs_error("Error in sending IFB DOWN configure message\n");
 	}
+	nss_ifb_info_put(ifb_info);
 }
 
 /*
@@ -541,6 +561,7 @@
 	if (!nss_ifb_up(ifb_info)) {
 		nss_igs_error("Error in sending IFB UP configure message\n");
 	}
+	nss_ifb_info_put(ifb_info);
 }
 
