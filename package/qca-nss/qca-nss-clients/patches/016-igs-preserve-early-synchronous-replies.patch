nss-clients: preserve IGS replies received before the waiter starts

Use the kernel completion contract for a reply that can precede the wait.
Reinitialize under the existing semaphore before transmission, not after
the reply can arrive. Keep the static lifetime, timeout and message ABI.

This does not correlate late replies to requests or repair firmware
transaction compensation and registration ownership.

--- a/nss_qdisc/igs/nss_ifb.c
+++ b/nss_qdisc/igs/nss_ifb.c
@@ -14,6 +14,7 @@
  **************************************************************************
  */
 
+#include <linux/completion.h>
 #include <nss_api_if.h>
 #include <nss_cmn.h>
 #include <net/netfilter/nf_conntrack_dscpremark_ext.h>
@@ -35,9 +36,8 @@
  */
 static struct nss_ifb_msg_response {
 	struct semaphore sem;
-	wait_queue_head_t wq;
+	struct completion done;
 	enum nss_cmn_response response;
-	bool cond;
 } msg_response;
 
 /*
@@ -177,8 +177,7 @@
 static void nss_ifb_wake_up_cb(void *app_data, struct nss_if_msg *nim)
 {
 	msg_response.response = nim->cm.response;
-	msg_response.cond = 0;
-	wake_up(&msg_response.wq);
+	complete(&msg_response.done);
 }
 
 /*
@@ -286,6 +285,8 @@
 	}
 
 	down(&msg_response.sem);
+	/* A reply may arrive before transmission returns or waiting starts. */
+	reinit_completion(&msg_response.done);
 	ret = nss_if_tx_msg(nss_igs_get_context(), &nim);
 	if (ret != NSS_TX_SUCCESS) {
 		up(&msg_response.sem);
@@ -293,8 +294,7 @@
 		return -1;
 	}
 
-	msg_response.cond = 1;
-	if (!wait_event_timeout(msg_response.wq, msg_response.cond == 0, NSS_IFB_MSG_TIMEOUT)) {
+	if (!wait_for_completion_timeout(&msg_response.done, NSS_IFB_MSG_TIMEOUT)) {
 		nss_igs_error("config for attach interface msg timeout\n");
 		up(&msg_response.sem);
 		return -1;
@@ -447,7 +447,7 @@
 void nss_ifb_init()
 {
 	sema_init(&msg_response.sem, 1);
-	init_waitqueue_head(&msg_response.wq);
+	init_completion(&msg_response.done);
 }
 
 /*
--- a/nss_qdisc/igs/nss_ifb.h
+++ b/nss_qdisc/igs/nss_ifb.h
@@ -14,7 +14,7 @@
  **************************************************************************
  */
 
-#define NSS_IFB_MSG_TIMEOUT (600*HZ)	/* 1 min timeout */
+#define NSS_IFB_MSG_TIMEOUT (600*HZ)	/* 10 minute timeout */
 
 /*
  * nss_ifb_if_config
