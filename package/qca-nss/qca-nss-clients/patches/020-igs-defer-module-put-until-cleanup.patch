nss-clients: defer IGS module put until root cleanup completes

nss_qdisc_destroy() dropped the IGS owner reference immediately after
starting the asynchronous root cleanup. The cleanup callback and the
virtual-interface teardown can still enter IGS code after that put.

Move the put to the end of the destroy path and require cleanup to have
reached IDLE. If cleanup times out, retain the reference and report it:
leaking the reference is safer than calling into an unloaded module.

This is a bounded root-destroy lifetime fix. It does not add a per-IFB
callback reference, a request identity, or a transport drain; those remain
separate contracts.

--- a/nss_qdisc/nss_qdisc.c
+++ b/nss_qdisc/nss_qdisc.c
@@ -1922,6 +1922,7 @@
 {
 	int32_t state;
 	nss_tx_status_t cmd_status;
+	bool is_igs_root;
 
 	nss_qdisc_info("Qdisc %px (type %d) destroy\n",
 			nq->qdisc, nq->type);
@@ -1947,6 +1948,9 @@
 				"state: %d\n", nq->qdisc, nq->type, state);
 		return;
 	}
+
+	is_igs_root = nq->is_root &&
+		nss_igs_verify_if_num(nq->nss_interface_number);
 
 	/*
 	 * Delete node from stats list
@@ -1981,12 +1985,6 @@
 		 */
 		nss_qdisc_root_cleanup_free_node(nq);
 
-		/*
-		 * In case of IGS interface, release the reference of the IGS module.
-		 */
-		if (nss_igs_verify_if_num(nq->nss_interface_number)) {
-			nss_igs_module_put();
-		}
 	}
 
 	/*
@@ -2015,6 +2013,20 @@
 						nq->qdisc, nq->virt_if_ctx, cmd_status);
 		}
 		nq->virt_if_ctx = NULL;
+	}
+
+	/*
+	 * The IGS module reference protects asynchronous root cleanup.
+	 * Drop it only after cleanup reached IDLE and synchronous virtual
+	 * interface teardown completed. On timeout, retain the reference:
+	 * a leak is safer than calling into a module that may be unloaded.
+	 */
+	if (is_igs_root) {
+		if (state == NSS_QDISC_STATE_IDLE)
+			nss_igs_module_put();
+		else
+			nss_qdisc_error("Qdisc %px (type %d): IGS cleanup incomplete; retaining module reference\n",
+					nq->qdisc, nq->type);
 	}
 
 	nss_qdisc_info("Qdisc %px (type %d): destroy complete\n",
