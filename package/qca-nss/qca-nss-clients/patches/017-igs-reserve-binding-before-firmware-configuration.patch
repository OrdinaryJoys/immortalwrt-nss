nss-clients: reserve IGS host binding storage before configuring firmware

Separate private host allocation from publication. Allocation failure must
not reach NSS or delete an interface registration borrowed by this attempt.
On later errors only cancel private unpublished storage. Binding publication
after the acknowledged steps cannot fail due to a new host allocation.

This does not establish firmware rollback, request generations, complete
registration ownership or nonbind replacement semantics.

--- a/nss_qdisc/igs/nss_ifb.c
+++ b/nss_qdisc/igs/nss_ifb.c
@@ -489,22 +489,49 @@
 }
 
 /*
+ * nss_ifb_prepare_bind()
+ *	Reserve private mapping storage before configuring NSS.
+ */
+struct nss_ifb_info *nss_ifb_prepare_bind(struct nss_ifb_info *ifb_info, bool *new_entry)
+{
+	*new_entry = false;
+	if (ifb_info) {
+		return ifb_info;
+	}
+
+	ifb_info = kmalloc(sizeof(*ifb_info), GFP_KERNEL);
+	if (!ifb_info) {
+		nss_igs_error("kmalloc failed\n");
+		return NULL;
+	}
+
+	ifb_info->ifb_dev = NULL;
+	ifb_info->map_dev = NULL;
+	ifb_info->is_mapped = false;
+	INIT_LIST_HEAD(&ifb_info->map_list);
+	*new_entry = true;
+	return ifb_info;
+}
+
+/*
+ * nss_ifb_abort_bind()
+ *	Only free unpublished storage allocated by this attempt, not a NSS node.
+ */
+void nss_ifb_abort_bind(struct nss_ifb_info *ifb_info, bool new_entry)
+{
+	if (new_entry) {
+		kfree(ifb_info);
+	}
+}
+
+/*
  * nss_ifb_bind()
- *	API to bind an IFB device with its requested mapped interface.
- */
-int32_t nss_ifb_bind(struct nss_ifb_info *ifb_info, struct net_device *from_dev,
-		struct net_device *to_dev)
-{
-	if (!ifb_info) {
-		/*
-		 * IFB not present in local LL.
-		 * Add the entry in LL.
-		 */
-		ifb_info = kmalloc(sizeof(*ifb_info), GFP_KERNEL);
-		if (!ifb_info) {
-			nss_igs_error("kmalloc failed\n");
-			return -ENOMEM;
-		}
+ *	Publish a prepared binding; no fallible allocation remains after NSS config.
+ */
+void nss_ifb_bind(struct nss_ifb_info *ifb_info, struct net_device *from_dev,
+		struct net_device *to_dev, bool new_entry)
+{
+	if (new_entry) {
 		ifb_info->ifb_dev = to_dev;
 		ifb_info->map_dev = from_dev;
 		ifb_info->is_mapped = true;
@@ -519,7 +546,6 @@
 		ifb_info->is_mapped = true;
 		spin_unlock_bh(&nss_ifb_list_lock);
 	}
-	return 0;
 }
 
