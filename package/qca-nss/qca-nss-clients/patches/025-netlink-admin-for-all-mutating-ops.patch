From: AX6 local review
Subject: [PATCH] netlink: require global admin for all mutating controls

QRFS, GRE redirect and UDP speed-test control shared NSS resources.
Require the same initial-user-namespace CAP_NET_ADMIN permission as
IPv4/IPv6 rule injection. Leave stats and notification operations alone.

--- a/netlink/nss_nlqrfs.c
+++ b/netlink/nss_nlqrfs.c
@@ -56,10 +56,10 @@
 /*
  * operation table called by the generic netlink layer based on the command
  */
 static struct genl_ops nss_nlqrfs_ops[] = {
-	{.cmd = NSS_QRFS_MSG_FLOW_ADD, .doit = nss_nlqrfs_ops_add_rule,},
+	{.cmd = NSS_QRFS_MSG_FLOW_ADD, .doit = nss_nlqrfs_ops_add_rule, .flags = GENL_ADMIN_PERM,},
-	{.cmd = NSS_QRFS_MSG_FLOW_DELETE, .doit = nss_nlqrfs_ops_del_rule,},
+	{.cmd = NSS_QRFS_MSG_FLOW_DELETE, .doit = nss_nlqrfs_ops_del_rule, .flags = GENL_ADMIN_PERM,},
 };
 
