From: OpenWrt Build System <openwrt@localhost>
Subject: [PATCH] edma-v1: retire port and shared NAPI CPU owners

Separate probe abort from takeover accounting, retire per-port host-open
membership after callback drain, and use a persistent dummy NAPI owner.
RCU covers both port readers and the complete poll tail. Track each IRQ
acquisition and keep MMIO ownership after host override until final exit.
Only successful NAPI completion rearms interrupts. Overridden IDs cannot
return to host EDMA without a separate firmware/registry ownership contract.
No hardware idle, FW epoch or external netdev-cache guarantee is added.

diff --git a/nss_dp_main.c b/nss_dp_main.c
--- a/nss_dp_main.c
+++ b/nss_dp_main.c
@@ -1156,6 +1156,35 @@
 /*
  * nss_dp_probe()
  */
+#ifdef NSS_DP_IPQ807X
+static void nss_dp_clear_host_ctx(struct nss_dp_dev *dp)
+{
+	struct nss_dp_data_plane_ctx *host;
+
+	ASSERT_RTNL();
+	if (!dp->macid || dp->macid > NSS_DP_HAL_MAX_PORTS)
+		return;
+	host = &dp_global_data_plane_ctx[nss_dp_get_idx_from_macid(dp->macid)];
+	if (host->dev == dp->netdev)
+		host->dev = NULL;
+}
+
+static void nss_dp_abort_host_probe(struct nss_dp_dev *dp)
+{
+	struct nss_dp_data_plane_ctx *host;
+
+	if (!dp->macid || dp->macid > NSS_DP_HAL_MAX_PORTS)
+		return;
+	rtnl_lock();
+	host = &dp_global_data_plane_ctx[nss_dp_get_idx_from_macid(dp->macid)];
+	if (host->dev == dp->netdev) {
+		edma_retire_port(dp->netdev, dp->macid);
+		nss_dp_clear_host_ctx(dp);
+	}
+	rtnl_unlock();
+}
+#endif
+
 static int32_t nss_dp_probe(struct platform_device *pdev)
 {
 	struct net_device *netdev;
