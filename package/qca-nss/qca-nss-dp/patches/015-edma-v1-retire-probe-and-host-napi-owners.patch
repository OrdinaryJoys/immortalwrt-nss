+static void edma_free_irqs(void)
+{
+	ASSERT_RTNL();
+	if (edma_hw.misc_irq_owned) {
+		free_irq(edma_hw.misc_intr, edma_hw.pdev);
+		edma_hw.misc_irq_owned = false;
+	}
+	while (edma_hw.rxdesc_irqs_owned) {
+		--edma_hw.rxdesc_irqs_owned;
+		free_irq(edma_hw.rxdesc_intr[edma_hw.rxdesc_irqs_owned], edma_hw.pdev);
+	}
+	while (edma_hw.rxfill_irqs_owned) {
+		--edma_hw.rxfill_irqs_owned;
+		free_irq(edma_hw.rxfill_intr[edma_hw.rxfill_irqs_owned], edma_hw.pdev);
+	}
+	while (edma_hw.tx_irqs_owned) {
+		--edma_hw.tx_irqs_owned;
+		free_irq(edma_hw.txcmpl_intr[edma_hw.tx_irqs_owned], edma_hw.pdev);
+	}
+}
+
+static void edma_stop_napi(void)
+{
+	ASSERT_RTNL();
+	edma_disable_interrupts();
+	if (edma_hw.napi_enabled) {
+		napi_disable(&edma_hw.napi);
+		edma_hw.napi_enabled = false;
+	}
+	/* Ownership can be released before the poll's final MMIO access. */
+	synchronize_net();
+	edma_disable_interrupts();
+}
+
+static void edma_release_mmio(void)
+{
+	ASSERT_RTNL();
+	platform_set_drvdata(edma_hw.pdev, NULL);
+	if (edma_hw.reg_base) {
+		iounmap(edma_hw.reg_base);
+		edma_hw.reg_base = NULL;
+	}
+	if (edma_hw.reg_resource) {
+		release_mem_region(edma_hw.reg_resource->start,
+				resource_size(edma_hw.reg_resource));
+		edma_hw.reg_resource = NULL;
+	}
+}
