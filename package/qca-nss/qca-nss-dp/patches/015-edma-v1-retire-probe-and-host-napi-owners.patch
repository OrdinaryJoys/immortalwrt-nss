+
+static void edma_close_member(uint32_t index)
+{
+	ASSERT_RTNL();
+	if (!edma_hw.host_open[index])
+		return;
+	edma_hw.host_open[index] = false;
+	if (--edma_hw.active == 0)
+		edma_stop_napi();
+}
+
+bool edma_retire_port(struct net_device *netdev, uint32_t macid)
+{
+	uint32_t index;
+
+	ASSERT_RTNL();
+	if (!netdev || macid < EDMA_START_GMACS || macid > EDMA_MAX_GMACS)
+		return false;
+	index = macid - 1;
+	if (rcu_access_pointer(edma_hw.netdev_arr[index]) != netdev)
+		return false;
+	edma_close_member(index);
+	rcu_assign_pointer(edma_hw.netdev_arr[index], NULL);
+	synchronize_net();
+	return true;
 }
 
