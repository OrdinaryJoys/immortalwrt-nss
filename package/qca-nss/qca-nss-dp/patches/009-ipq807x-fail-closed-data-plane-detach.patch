 			       struct nss_dp_data_plane_ops *dp_ops,
@@ -190,6 +199,12 @@ int nss_dp_override_data_plane(struct net_device *netdev,
  *
  * @param[in] netdev Pointer to netdev structure.
  * @param[in] dpc Pointer to data plane context.
+ *
+ * IPQ807x EDMA v1: caller must hold RTNL and call this once after every
+ * successful override, only after all RX registrations are ready. The previous
+ * administrative-open state is retained by DP: a previously DOWN port is not
+ * opened. A failed start permanently quarantines the port. No hot recovery is
+ * provided; other platforms retain their existing start semantics.
  */
 void nss_dp_start_data_plane(struct net_device *netdev,
 			     struct nss_dp_data_plane_ctx *dpc);
@@ -202,6 +217,16 @@ void nss_dp_start_data_plane(struct net_device *netdev,
  * net_device
  *
  * @param[in] netdev Pointer to netdev structure.
+ *
+ * IPQ807x EDMA v1: caller must hold RTNL and retain its callback/context until
+ * this function returns. DP blocks and drains all admitted callbacks, then
+ * permanently installs DP-owned quarantine ops/context, clears all feature
+ * declarations and disables host TX/RX admission. It does not send NSS close
+ * commands or reinitialize EDMA. Caller still owns NSS firmware/RX-registry
+ * teardown and must independently drain those readers before freeing netdev;
+ * the DP reader gate is not a netdev lifetime reference. Do not call restore
+ * from an admitted callback or while holding a PHY device lock.
+ * Repeated detach is safe; ordinary reopen/reoverride cannot undo quarantine.
  */
 void nss_dp_restore_data_plane(struct net_device *netdev);
 
