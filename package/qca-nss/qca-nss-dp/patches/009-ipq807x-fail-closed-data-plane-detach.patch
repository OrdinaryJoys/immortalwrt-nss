@@ -32,6 +34,180 @@ static inline void nss_dp_reset_netdev_features(struct net_device *netdev)
 	netdev->wanted_features = 0;
 }
 
+#ifdef NSS_DP_IPQ807X
+/*
+ * IPQ807x EDMA v1 has no Linux checksum-offload fallback implementation.
+ * Detach therefore permanently isolates this port instead of selecting EDMA.
+ * No NSS command, EDMA reinitialization, ring or IRQ change occurs here.
+ */
+static int nss_dp_quarantine_init(struct nss_dp_data_plane_ctx *dpc)
+{
+	return -ENODEV;
+}
+
+static int nss_dp_quarantine_open(struct nss_dp_data_plane_ctx *dpc,
+		uint32_t tx, uint32_t rx, uint32_t mode)
+{
+	return -ENODEV;
+}
+
+static int nss_dp_quarantine_noop(struct nss_dp_data_plane_ctx *dpc)
+{
+	return 0;
+}
+
+static int nss_dp_quarantine_value(struct nss_dp_data_plane_ctx *dpc,
+		uint32_t value)
+{
+	return -ENODEV;
+}
+
+static int nss_dp_quarantine_mac(struct nss_dp_data_plane_ctx *dpc,
+		uint8_t *addr)
+{
+	return -ENODEV;
+}
+
+static netdev_tx_t nss_dp_quarantine_xmit(struct nss_dp_data_plane_ctx *dpc,
+		struct sk_buff *skb)
+{
+	dev_core_stats_tx_dropped_inc(dpc->dev);
+	dev_kfree_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+static void nss_dp_quarantine_features(struct nss_dp_data_plane_ctx *dpc)
+{
+	nss_dp_reset_netdev_features(dpc->dev);
+}
+
+static struct nss_dp_data_plane_ops nss_dp_quarantine_ops = {
+	.init = nss_dp_quarantine_init,
+	.open = nss_dp_quarantine_open,
+	.close = nss_dp_quarantine_noop,
+	.link_state = nss_dp_quarantine_value,
+	.mac_addr = nss_dp_quarantine_mac,
+	.change_mtu = nss_dp_quarantine_value,
+	.xmit = nss_dp_quarantine_xmit,
+	.set_features = nss_dp_quarantine_features,
+	.pause_on_off = nss_dp_quarantine_value,
+	.deinit = nss_dp_quarantine_noop,
+};
+
+void nss_dp_plane_init(struct nss_dp_dev *dp)
+{
+	spin_lock_init(&dp->plane_lock);
+	init_waitqueue_head(&dp->plane_wait);
+	dp->plane_readers = 0;
+	dp->plane_blocked = false;
+	dp->plane_quarantined = false;
+	dp->plane_pending = false;
+	dp->plane_was_open = false;
+	dp->phy_started = false;
+	dp->quarantine_ctx.dev = dp->netdev;
+}
+
+bool nss_dp_plane_get(struct nss_dp_dev *dp, struct nss_dp_plane_ref *ref)
+{
+	bool admitted = false;
+
+	spin_lock_bh(&dp->plane_lock);
+	if (!dp->plane_blocked && !dp->plane_quarantined &&
+			dp->data_plane_ops && dp->dpc) {
+		ref->ops = dp->data_plane_ops;
+		ref->dpc = dp->dpc;
+		dp->plane_readers++;
+		admitted = true;
+	}
+	spin_unlock_bh(&dp->plane_lock);
+	return admitted;
+}
+
+void nss_dp_plane_put(struct nss_dp_dev *dp)
+{
+	bool drained;
+
+	spin_lock_bh(&dp->plane_lock);
+	if (WARN_ON_ONCE(!dp->plane_readers)) {
+		spin_unlock_bh(&dp->plane_lock);
+		return;
+	}
+	drained = (--dp->plane_readers == 0);
+	spin_unlock_bh(&dp->plane_lock);
+	if (drained)
+		wake_up_all(&dp->plane_wait);
+}
+
+bool nss_dp_plane_is_quarantined(struct nss_dp_dev *dp)
+{
+	bool quarantined;
+
+	spin_lock_bh(&dp->plane_lock);
+	quarantined = dp->plane_quarantined;
+	spin_unlock_bh(&dp->plane_lock);
+	return quarantined;
+}
+
+void nss_dp_plane_stop_phy(struct nss_dp_dev *dp)
+{
+	ASSERT_RTNL();
+	if (dp->phy_started) {
+		dp->phy_started = false;
+		if (dp->phydev)
+			phy_stop(dp->phydev);
+	}
+}
+
+void nss_dp_plane_quiesce(struct nss_dp_dev *dp)
+{
+	ASSERT_RTNL();
+	might_sleep();
+	spin_lock_bh(&dp->plane_lock);
+	dp->plane_blocked = true;
+	spin_unlock_bh(&dp->plane_lock);
+
+	/* Never call this while retaining a plane_get() reference. */
+	netif_device_detach(dp->netdev);
+	netif_tx_disable(dp->netdev);
+	nss_dp_plane_stop_phy(dp);
+	wait_event(dp->plane_wait, !READ_ONCE(dp->plane_readers));
+
+	/* An old PHY/RX callback may have raised carrier before it exited. */
+	netif_tx_disable(dp->netdev);
+	netif_carrier_off(dp->netdev);
+}
+
+void nss_dp_plane_quarantine(struct nss_dp_dev *dp)
+{
+	ASSERT_RTNL();
+	nss_dp_plane_quiesce(dp);
+	clear_bit(__NSS_DP_UP, &dp->flags);
+	dp->link_state = __NSS_DP_LINK_DOWN;
+	dp->drv_flags &= ~(NSS_DP_PRIV_FLAG(INIT_DONE) |
+			   NSS_DP_PRIV_FLAG(INIT_OVERRIDE));
+	nss_dp_reset_netdev_features(dp->netdev);
+
+	spin_lock_bh(&dp->plane_lock);
+	dp->data_plane_ops = &nss_dp_quarantine_ops;
+	dp->dpc = &dp->quarantine_ctx;
+	dp->plane_pending = false;
+	dp->plane_was_open = false;
+	dp->plane_quarantined = true;
+	spin_unlock_bh(&dp->plane_lock);
+}
+
+void nss_dp_plane_resume(struct nss_dp_dev *dp)
+{
+	ASSERT_RTNL();
+	spin_lock_bh(&dp->plane_lock);
+	if (!dp->plane_quarantined)
+		dp->plane_blocked = false;
+	spin_unlock_bh(&dp->plane_lock);
+	if (!nss_dp_plane_is_quarantined(dp))
+		netif_device_attach(dp->netdev);
+}
+#endif
