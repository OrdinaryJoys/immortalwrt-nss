--- a/nss_dp_main.c
+++ b/nss_dp_main.c
@@ -310,6 +310,26 @@
 	return 0;
 }
 
+/* Keep read order and last-good publication in one non-sleeping callback domain. */
+static void nss_dp_collect_stats(struct nss_dp_dev *dp_priv,
+				 struct rtnl_link_stats64 *stats)
+{
+	struct rtnl_link_stats64 fresh = { 0 };
+	unsigned long flags;
+
+	spin_lock_irqsave(&dp_priv->stats_lock, flags);
+	if (dp_priv->gmac_hal_ops->getndostats(dp_priv->gmac_hal_ctx, &fresh)) {
+		dp_priv->stats_read_failures++;
+		dp_priv->stats_stale = true;
+	} else {
+		dp_priv->last_stats = fresh;
+		dp_priv->stats_valid = true;
+		dp_priv->stats_stale = false;
+	}
+	*stats = dp_priv->last_stats;
+	spin_unlock_irqrestore(&dp_priv->stats_lock, flags);
+}
+
 /*
  * nss_dp_get_stats64()
  */
@@ -327,7 +347,7 @@
 	/*
 	 * Get the GMAC MIB statistics
 	 */
-	dp_priv->gmac_hal_ops->getndostats(dp_priv->gmac_hal_ctx, stats);
+	nss_dp_collect_stats(dp_priv, stats);
 	return stats;
 }
 #else
