 	uint32_t data;
 	int store_idx;
@@ -281,15 +281,10 @@
 
 	while (cons_idx != prod_idx) {
 		store_idx = cons_idx;
-		skb = ehw->tx_skb_store[store_idx];
-		ehw->tx_skb_store[store_idx] = NULL;
-
-		if (skb) {
-			dma_unmap_single(&pdev->dev,
-					ehw->tx_dma_store[store_idx],
-					skb_headlen(skb), DMA_TO_DEVICE);
-			ehw->tx_dma_store[store_idx] = 0;
-			dev_kfree_skb_any(skb);
+		if (edma_tx_slot_take(ehw, store_idx, txdesc_ring, &slot)) {
+			dma_unmap_single(&pdev->dev, slot.dma,
+					slot.len, DMA_TO_DEVICE);
+			dev_kfree_skb_any(slot.skb);
 		}
 
 		cons_idx++;
@@ -716,10 +711,10 @@
 	/*
 	 * Initialize the store
 	 */
+	spin_lock_init(&ehw->tx_slot_lock);
+	memset(ehw->tx_slots, 0, sizeof(ehw->tx_slots));
 	for (i = 0; i < EDMA_RING_SIZE; i++) {
-		ehw->tx_skb_store[i] = NULL;
 		ehw->rx_skb_store[i] = NULL;
-		ehw->tx_dma_store[i] = 0;
 	}
 
 	/*
