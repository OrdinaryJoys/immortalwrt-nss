 /*
@@ -1791,22 +1758,7 @@
  */
 bool ecm_front_end_check_tcp_denied_ports(uint16_t src_port, uint16_t dest_port)
 {
-	if (!atomic_read(&ecm_tcp_denied_port_count)) {
-		DEBUG_TRACE("No denied port for TCP\n");
-		return false;
-	}
-
-	/*
