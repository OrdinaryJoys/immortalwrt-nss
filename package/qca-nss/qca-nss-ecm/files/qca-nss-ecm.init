# WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
# MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
# ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
# WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
# ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
# OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.

# The shebang above has an extra space intentionally to avoid having
# openwrt build scripts automatically enable this package starting
# at boot.

START=26
USE_PROCD=1

write_if_writable() {
	local file="$1"
	local value="$2"

	[ -w "$file" ] && echo "$value" > "$file"
	return 0
}

sysctl_update() {
	local name value file

	name=${1//\//\\/}
	value=${2//\//\\/}
	file=${3:-/etc/sysctl.d/qca-nss-ecm.conf}

	if [ -r "/proc/sys/${name//./\/}" ]; then
		sed -i -e '/^#\?\(\s*'"${name}"'\s*=\s*\).*/{s//\1'"${value}"'/;:a;n;ba;q}' \
			-e '$a'"${name}"'='"${value}" "${file}"
		sysctl -w "${name}=${value}"
	else
		# If the sysctl value is not available but it is found in the file, disable it to avoid
		# sysctl throwing warnings
		if grep -qE '^#?\s*'"${name}\s*?=" "${file}"; then
			sed -i -e '/^#\?\(\s*'"${name}"'\s*=\s*\).*/{s//\#\1'"${value}"'/;:a;n;ba;q}' \
				-e '$a'"#${name}"'='"${value}" "${file}"
		fi
	fi
}

get_front_end_mode() {
	config_load "ecm"

	config_get front_end global acceleration_engine "auto"

	# shellcheck disable=2154
	case $front_end in
		auto)
			echo '0'
			;;
		nss)
			echo '1'
			;;
		both)
			echo '4'
			;;
		*)
			echo '0'
			;;
	esac
}

disable_packet_steering() {
	local changed=0 status=0 rc
	uci -q set network.globals.packet_steering='0' && changed=1 || status=$?
	# An absent optional key is not an error. A failed deletion is.
	if uci -q get network.globals.steering_flows >/dev/null; then
		uci -q delete network.globals.steering_flows && changed=1 || status=$?
	fi
	if [ "$changed" -ne 0 ]; then
		uci -q commit network || status=$?
	fi

	# Still restore the live queue policy if persistence failed.
	if [ -e "/usr/libexec/platform/packet-steering.sh" ]; then
		/usr/libexec/platform/packet-steering.sh 0
	else
		/usr/libexec/network/packet-steering.uc -l 0 0
	fi
	rc=$?
	[ "$status" -ne 0 ] || status="$rc"
	return "$status"
}

disable_bridge_filtering() {
	sysctl_update net.bridge.bridge-nf-call-arptables 0
	sysctl_update net.bridge.bridge-nf-call-iptables 0
	sysctl_update net.bridge.bridge-nf-call-ip6tables 0
}

enable_bridge_filtering() {

	# If bridge filtering is enabled, apply and persist the sysctl flags
	config_load ecm
	config_get enable_bridge_filtering general enable_bridge_filtering 0

	# shellcheck disable=2154
	if [ "$enable_bridge_filtering" -eq 1 ]; then
		sysctl_update net.bridge.bridge-nf-call-arptables 1
		sysctl_update net.bridge.bridge-nf-call-iptables 1
		sysctl_update net.bridge.bridge-nf-call-ip6tables 1
	else
		disable_bridge_filtering
	fi
}

set_front_end() {
	local get_front_end_mode=${1:-0}
	local module_conf=/etc/modules.conf
	[ ! -r "$module_conf" ] && touch "$module_conf"
	# If "options ecm" exists, modify or append front_end_selection
	if grep -q "^options ecm" "$module_conf"; then
		if grep -q "front_end_selection=" "$module_conf"; then
			sed -i -E "s/(options ecm.*)front_end_selection=[0-9]+/\1front_end_selection=$get_front_end_mode/" "$module_conf"
		else
			# Append front_end_selection if missing
			sed -i -E "s/^(options ecm.*)/\1 front_end_selection=$get_front_end_mode/" "$module_conf"
		fi
	else
		# Add new "options ecm" line
		echo "options ecm front_end_selection=$get_front_end_mode" >> "$module_conf"
	fi
}

apply_interface_offload_policy() {
	local status=0
	# The helper is optional on other targets. Its reported failures are not.
	if [ -r /lib/netifd/offload/disable_offloads.sh ]; then
		. /lib/netifd/offload/disable_offloads.sh
		status=$?
		if [ "$status" -eq 0 ]; then
			disable_offload
			status=$?
		fi
		if [ "$status" -ne 0 ]; then
			logger -p daemon.err -t qca-nss-ecm "interface-offload policy failed (status $status)"
		fi
	fi
	return "$status"
}

load_ecm() {
	local status=0 dependencies get_front_end_mode
	[ -d /sys/module/ecm ] || {
		get_front_end_mode="$(get_front_end_mode)"
		dependencies="$(modinfo ecm)" || return $?
		printf '%s\n' "$dependencies" | awk '/depends/{gsub(",","\n",$NF);print $NF}' | xargs -r -n 1 modprobe || return $?
		set_front_end $get_front_end_mode || return $?
		modprobe ecm || return $?
		write_if_writable /sys/kernel/debug/ecm/ecm_classifier_default/accel_delay_pkts 1
	}

	apply_interface_offload_policy || status=$?

	#Flushout stale accelerated connections if any
	write_if_writable /sys/kernel/debug/ecm/ecm_db/defunct_all 1
	write_if_writable /proc/net/nf_conntrack f

	# Set conntrack event mode to 1 for 6.1 kernel to get the conntrack events from ECM
	local kernel_major
	kernel_major=$(uname -r | cut -d. -f1)
	if [ "$kernel_major" -eq 6 ]; then
		write_if_writable /proc/sys/net/netfilter/nf_conntrack_events 1
	fi
	return "$status"
}

unload_ecm() {
	disable_bridge_filtering

	# Change it back to 6.1 linux's default setting
	local kernel_major
	kernel_major="$(uname -r | cut -d. -f1)"
	if [ "$kernel_major" -eq 6 ]; then
		write_if_writable /proc/sys/net/netfilter/nf_conntrack_events 2
	fi

	if [ -d /sys/module/ecm ]; then
		#
		# Stop ECM frontends
		#
		write_if_writable /sys/kernel/debug/ecm/front_end_ipv4_stop 1
		write_if_writable /sys/kernel/debug/ecm/front_end_ipv6_stop 1

		#
		# Defunct the connections
		#
		write_if_writable /sys/kernel/debug/ecm/ecm_db/defunct_all 1
		write_if_writable /proc/net/nf_conntrack f

		sleep 1
		rmmod ecm
	fi
}

service_triggers() {
	procd_add_reload_trigger "network"
	procd_add_reload_trigger "packet_steering"
}

reload_service() {
	local steering_status=0 offload_status=0

	# Still apply the independent offload safety policy if queue ownership
	# restoration fails, but never let the later stage hide that failure.
	disable_packet_steering || steering_status=$?

	# Re-apply the configured interface-offload policy after a network
	# restart, because netifd or a driver rebind can restore netdev feature
	# defaults. EDMA v1 does not advertise hardware checksum support, but
	# Linux GRO/GSO are software batching features and are not inherently
	# corrupt. Board profiles can therefore select a conservative host-path
	# policy while leaving physical NSS data-plane ports report-only.
	if [ -r /lib/netifd/offload/disable_offloads.sh ]; then
		. /lib/netifd/offload/disable_offloads.sh && disable_offload || offload_status=$?
	fi

	if [ "$steering_status" -ne 0 ]; then
		logger -t qca-nss-ecm -p daemon.err "reload: packet steering failed (status $steering_status)" || :
	fi
	if [ "$offload_status" -ne 0 ]; then
		logger -t qca-nss-ecm -p daemon.err "reload: offload policy failed (status $offload_status)" || :
	fi
	[ "$steering_status" -eq 0 ] || return "$steering_status"
	return "$offload_status"
}

start_service() {
	# rc.common closes the procd declaration after this callback, replacing
	# its exit status. service_started exposes our result to the caller.
	ecm_start_status=0
	load_ecm || ecm_start_status=$?

	disable_packet_steering || ecm_start_status=$?

	# Only enable bridge filtering if using deprecated fw3
	if [ ! -r /sbin/fw4 ]; then
		enable_bridge_filtering || ecm_start_status=$?
	else
		disable_bridge_filtering || ecm_start_status=$?
	fi

	# If the acceleration engine is NSS, enable wifi redirect
	if [ -d /sys/kernel/debug/ecm/ecm_nss_ipv4 ] && [ -w /proc/sys/dev/nss/general/redirect ]; then
		sysctl -w dev.nss.general.redirect=1 || ecm_start_status=$?
	fi

	if [ -d /sys/module/qca_ovsmgr ]; then
		insmod ecm_ovs || ecm_start_status=$?
	fi
	if [ "$ecm_start_status" -ne 0 ]; then
		logger -p daemon.err -t qca-nss-ecm "startup policy incomplete (status $ecm_start_status)"
	fi
	return "$ecm_start_status"
}

service_started() {
	return "${ecm_start_status:-1}"
}

stop_service() {
	# If ECM is already not loaded, just return
	if [ ! -d /sys/module/ecm ]; then
		return
	fi

	# If the acceleration engine is NSS, disable wifi redirect
	[ -d /sys/kernel/debug/ecm/ecm_nss_ipv4 ] && [ -w /proc/sys/dev/nss/general/redirect ] && sysctl -w dev.nss.general.redirect=0

	if [ -d /sys/module/ecm_ovs ]; then
		rmmod ecm_ovs
	fi

	unload_ecm
}
