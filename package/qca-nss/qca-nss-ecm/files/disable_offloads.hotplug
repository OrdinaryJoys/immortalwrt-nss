#!/bin/sh
# shellcheck disable=1090
#
# Physical-port offload policy hotplug (P0-C unified).
#
# When a physical netdev comes up (ACTION=add), apply the ECM offload
# policy via the single disable_offload() entry point.  The policy is
# UCI-driven inside disable_offload():
#   ecm.general.offload_host_ifaces      — host-path interfaces (hard disable)
#   ecm.general.offload_physical_policy   — "disable" (default) or "report"
#
# Default (no UCI): force-disable all physical interfaces — preserves
# upstream qualcommax behaviour unchanged.
#
# AX6 stock: offload_host_ifaces="br-lan", physical_policy="report"
# means physical ports are logged without forced changes. Virtual host-path
# interfaces are handled by parameterless init/reload calls or a board overlay
# hotplug hook when the bridge is recreated.
#
# ECM init, reload, and this hotplug share the same UCI-driven path.
#

PROG=${0##*/}

[ "$ACTION" != "add" ] && exit 0
[ -n "$INTERFACE" ] || exit 0

INC="/lib/netifd/offload/disable_offloads.sh"
. "$INC" 2> /dev/null || {
	logger -t "$PROG" -p user.error "missing include script $INC. exiting..."
	exit 1
}

# This package hotplug handles physical interfaces only. Virtual host paths are
# deliberately left to init/reload or a board-specific bridge hotplug hook.
if [ -r "/sys/class/net/$INTERFACE/device" ]; then
	disable_offload "$INTERFACE"
fi

exit 0
