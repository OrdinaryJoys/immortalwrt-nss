#!/bin/sh
# shellcheck disable=1090
#
# Physical-port offload audit hotplug.
#
# When a physical netdev comes up (ACTION=add), log its current ethtool
# offload state WITHOUT changing it. Forwarded traffic on NSS data-plane
# ports (wan, lan1-3) goes through the NSS/PPE hardware, not the Linux
# network stack; blanket-disabling offloads on these ports reduces
# fallback-path performance without a proven correctness benefit.
#
# br-lan host-path offload protection is handled separately by the ECM
# init script (qca-nss-ecm.init → load_ecm → disable_offload).
#
# This hotplug gathers per-interface baseline data for future per-feature
# A/B testing. When a specific offload feature is proven harmful on a
# specific physical port, the disable policy can be targeted.
#
# Fixes C-06 from AX6 cross-audit 2026-07-26.

PROG=${0##*/}

[ "$ACTION" != "add" ] && exit 0
[ -n "$INTERFACE" ] || exit 0

INC="/lib/netifd/offload/disable_offloads.sh"
. "$INC" 2> /dev/null || {
	logger -t "$PROG" -p user.error "missing include script $INC. exiting..."
	exit 1
}

# Physical ports: log current state, don't force-disable.
if [ -r "/sys/class/net/$INTERFACE/device" ]; then
	config_load ecm
	config_get_bool disable_offloads general disable_offloads 0

	if [ "$disable_offloads" -eq 1 ]; then
		if ethtool -k "$INTERFACE" 1>/dev/null 2>/dev/null; then
			enabled=$(ethtool -k "$INTERFACE" 2>/dev/null | awk '$2 == "on" {printf "%s%s", sep, $1; sep=", "}')
			if [ -n "$enabled" ]; then
				logger -t "[offload-report]" \
					"$INTERFACE: offloads ON ($enabled) — physical NSS data-plane port; forwarded traffic uses NSS/PPE. Per-feature A/B pending."
			else
				logger -t "[offload-report]" \
					"$INTERFACE: all offloads off"
			fi
		fi
	fi
fi

exit 0
