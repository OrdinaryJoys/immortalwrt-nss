# AX6 LED schedule
# enabled=0 leaves LED behaviour unchanged.
# on_time/off_time use 24h local time; LED is on inside [on_time, off_time).
# If on_time > off_time, the window crosses midnight.
config schedule 'schedule'
	option enabled '0'
	option on_time '07:00'
	option off_time '23:00'
	option days '1 2 3 4 5 6 7'
	option leds 'blue:system blue:network yellow:system yellow:network'
