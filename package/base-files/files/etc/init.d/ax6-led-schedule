#!/bin/sh /etc/rc.common
# Scheduled LED control for AX6

START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/ax6-led-schedule daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ax6_led
}

reload_service() {
	stop
	start
}
